<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit HR Employee Form -->
    <record id="view_hr_employee_form_inherit_hanson" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.hanson</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <!-- Add a new tab inside the main notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Employee Info">
                    <group col="2">
                        <field name="office"/>
                        <field name="employee_id_bio"/>
                        <field name="nickname"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
