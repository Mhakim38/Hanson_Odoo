<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Users: Read-only, own records -->
        <record id="attendance_rule_user_own" model="ir.rule">
            <field name="name">Attendance: user sees own records</field>
            <field name="model_id" ref="model_attendance_hanson"/>
            <field name="groups" eval="[(4, ref('attendance.group_attendance_user'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Manager: department records -->
        <record id="attendance_rule_manager_department" model="ir.rule">
            <field name="name">Attendance: manager sees department records</field>
            <field name="model_id" ref="model_attendance_hanson"/>
            <field name="groups" eval="[(4, ref('attendance.group_attendance_manager'))]"/>
            <field name="domain_force">[('department_id.manager_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Admin: all records -->
        <record id="attendance_rule_admin_all" model="ir.rule">
            <field name="name">Attendance: admin sees all</field>
            <field name="model_id" ref="model_attendance_hanson"/>
            <field name="groups" eval="[(4, ref('attendance.group_attendance_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
