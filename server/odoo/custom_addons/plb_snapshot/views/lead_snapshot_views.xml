<odoo>

    <!-- Tree View -->
    <record id="view_crm_lead_snapshot_tree" model="ir.ui.view">
        <field name="name">crm.lead.snapshot.tree</field>
        <field name="model">crm.lead.snapshot</field>
        <field name="arch" type="xml">
            <tree>
                <!-- User requested sequence -->
                <field name="create_date" string="Date Funnel"/>
                <field name="name" string="Opportunity"/>
                <field name="description" string="Remarks"/>
                <field name="user_id" string="PIC"/>
                <field name="expected_start_date" string="Expected Start Date"/>
                <field name="date_go_live" string="Date Go Live"/>
                <field name="scope_of_service" string="Scope of service"/>
                <field name="product" string="Product"/>
                <field name="dept_region" string="Dept/region"/>
                <field name="realized_revenue_fy2025" string="Realized Revenue FY2025"/>
                <field name="contact_name" string="Contact Name"/>
                <field name="email_from" string="Email"/>
                <field name="tag_list" string="Other Emails"/>
                <field name="user_id" string="Salesperson"/>
                <field name="expected_revenue" string="Expected Revenue"/>
                <field name="stage_id" string="Stage"/>
                <field name="probability" string="Probability"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_crm_lead_snapshot_search" model="ir.ui.view">
        <field name="name">crm.lead.snapshot.search</field>
        <field name="model">crm.lead.snapshot</field>
        <field name="arch" type="xml">
            <search>
                <field name="lead_id"/>
                <field name="stage_id"/>

                <filter name="filter_week"
                        string="This Week"
                        context="{'group_by': 'snapshot_date:week'}"/>
            </search>
        </field>
    </record>

    <!-- Correct Parent Menu (CRM → Reporting) -->
    <menuitem id="menu_crm_lead_snapshot_root"
              name="Lead Snapshots"
              parent="crm.crm_menu_sales"
              sequence="90"/>

    <!-- Action -->
    <record id="action_crm_lead_snapshot" model="ir.actions.act_window">
        <field name="name">Lead Snapshots</field>
        <field name="res_model">crm.lead.snapshot</field>
        <field name="view_mode">tree,search</field>
    </record>

