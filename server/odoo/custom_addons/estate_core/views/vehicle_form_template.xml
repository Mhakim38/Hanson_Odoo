<odoo>

  <!-- Vehicle Registration -->
  <template id="vehicle_form_template" name="Vehicle Registration">
    <t t-call="website.layout">
      <t t-call="visitor_mgmt.portal_navbar"/>
      <div class="oe_structure oe_empty"/>
      <div class="container my-5">
        <div class="row justify-content-center">
          <div class="col-lg-8 col-md-10">
            <div class="card shadow-lg border-0 mb-5">
              <div class="card-header bg-primary text-white text-center">
                <h2 class="mb-0">Vehicle Registration</h2>
              </div>
              <div class="card-body">

                <!-- Error Display -->
                <t t-if="error">
                  <div class="alert alert-danger"><t t-esc="error"/></div>
                </t>

                <!-- If user has no linked units -->
                <t t-if="not units">
                  <div class="alert alert-warning text-center">
                    You don't have any registered property units. Please contact the management office.
                  </div>
                </t>

                <t t-if="units">
                  <form action="/estate/vehicle/submit" method="post" class="o_form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <!-- Unit -->
                    <div class="mb-3">
                      <label for="unit_id" class="form-label fw-semibold">Select Unit</label>
                      <select name="unit_id" class="form-select form-select-lg" required="required">
                        <option disabled="disabled" selected="selected" value="">Select your unit</option>
                        <t t-foreach="units" t-as="u">
                          <option t-att-value="u.id">
                            <t t-esc="u.display_name"/>
                            <t t-if="u.street"> (<t t-esc="u.street"/>)</t>
                          </option>
                        </t>
                      </select>
                    </div>

                    <!-- Plate Number -->
                    <div class="mb-3">
                      <label for="plate_no" class="form-label fw-semibold">Plate Number</label>
                      <input type="text" name="plate_no" class="form-control form-control-lg" placeholder="e.g. ABC1234" required="required"/>
                    </div>

                    <!-- Make & Model -->
                    <div class="row">
                      <div class="col mb-3">
                        <label for="make" class="form-label fw-semibold">Make</label>
                        <input type="text" name="make" class="form-control" placeholder="e.g. Toyota"/>
                      </div>
                      <div class="col mb-3">
                        <label for="model" class="form-label fw-semibold">Model</label>
                        <input type="text" name="model" class="form-control" placeholder="e.g. Vios"/>
                      </div>
                    </div>

                    <!-- Color -->
                    <div class="mb-4">
                      <label for="color" class="form-label fw-semibold">Color</label>
                      <input type="text" name="color" class="form-control" placeholder="e.g. White"/>
                    </div>

                    <!-- Submit -->
                    <div class="d-grid mb-3">
                      <button type="submit" class="btn btn-primary btn-lg">Submit</button>
                    </div>
                  </form>
                </t>
              </div>
            </div>

            <!-- Registered Vehicles Table -->
            <t t-if="vehicles">
              <div class="card shadow-sm border-0">
                <div class="card-header bg-light text-center">
                  <h4 class="mb-0">Your Registered Vehicles</h4>
                </div>
                <div class="card-body p-0">
                  <table class="table table-striped table-hover mb-0">
                    <thead class="table-primary">
                      <tr>
                        <th>#</th>
                        <th>Unit</th>
                        <th>Plate No</th>
                        <th>Make / Model</th>
                        <th>Color</th>
                        <th class="text-center">Status</th>
                      </tr>
                    </thead>
                   <tbody>
                      <t t-set="index" t-value="1"/>
                      <t t-foreach="vehicles" t-as="v">
                        <tr>
                          <td><t t-esc="index"/></td>
                          <td><t t-esc="v.unit_id.display_name"/></td>
                          <td><t t-esc="v.plate_no"/></td>
                          <td>
                            <t t-esc="v.make"/>
                            <t t-if="v.model"> / <t t-esc="v.model"/></t>
                          </td>
                          <td><t t-esc="v.color"/></td>
                          <td class="text-center">
                            <span t-if="v.status" class="badge bg-success">Active</span>
                            <span t-if="not v.status" class="badge bg-secondary">Inactive</span>
                          </td>
                        </tr>
                        <t t-set="index" t-value="index + 1"/>
                      </t>
                    </tbody>




                  </table>
                </div>
              </div>
            </t>

            <t t-if="not vehicles">
              <div class="alert alert-info mt-4 text-center">
                You have no registered vehicles yet.
              </div>
            </t>

          </div>
        </div>
      </div>
    </t>
  </template>

  <!-- Thank You Page -->
  <template id="vehicle_form_thanks" name="Vehicle Registration Success">
    <t t-call="website.layout">
      <div class="container my-5">
        <div class="row justify-content-center">
          <div class="col-lg-6 col-md-8 text-center">
            <div class="card shadow-sm border-0">
              <div class="card-body">
                <h2 class="text-success mb-3">Vehicle Registered!</h2>
                <p class="lead mb-4">
                  Your vehicle <strong><t t-esc="plate_no"/></strong> has been successfully registered under
                  <strong><t t-esc="host_name"/></strong>.
                </p>
                <a href="/estate/vehicle" class="btn btn-outline-primary">Register Another Vehicle</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>

</odoo>
