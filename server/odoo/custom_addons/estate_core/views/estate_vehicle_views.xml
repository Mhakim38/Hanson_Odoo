<odoo>
  <record id="view_estate_vehicle_tree" model="ir.ui.view">
    <field name="name">estate.vehicle.tree</field>
    <field name="model">estate.vehicle</field>
    <field name="arch" type="xml">
      <tree>
        <field name="unit_id"/>
        <field name="host_id"/>
        <field name="plate_no"/>
        <field name="make"/>
        <field name="model"/>
        <field name="color"/>
        <field name="tag_type"/>
        <field name="valid_to"/>
        <field name="status"/>
      </tree>
    </field>
  </record>

  <record id="view_estate_vehicle_form" model="ir.ui.view">
    <field name="name">estate.vehicle.form</field>
    <field name="model">estate.vehicle</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="status"/>
            <field name="unit_id"/>
            <field name="host_id"/>
            <field name="plate_no"/>
            <field name="make"/>
            <field name="model"/>
            <field name="color"/>
            <field name="tag_type"/>
            <field name="tag_code"/>
            <field name="valid_from"/>
            <field name="valid_to"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_estate_vehicle" model="ir.actions.act_window">
    <field name="name">Vehicles</field>
    <field name="res_model">estate.vehicle</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
