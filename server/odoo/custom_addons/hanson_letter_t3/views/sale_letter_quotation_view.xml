<odoo>
    <record id="view_order_form_letter" model="ir.ui.view">
        <field name="name">sale.order.letter.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_management.sale_order_form_quote"/>
        <field name="arch" type="xml">

            <!-- Place radio above SO number -->
            <xpath expr="//sheet" position="inside">
                <field name="quotation_type" widget="radio"/>
            </xpath>

            <!-- Add Subject below customer -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="subject" style="font-size:30px; font-weight:900; text-decoration:underline;"/>
            </xpath>

            <!-- Hide fields -->
            <xpath expr="//field[@name='validity_date']" position="attributes">
                <attribute name="invisible">quotation_type == 'letter'</attribute>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="invisible">quotation_type == 'letter'</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="invisible">quotation_type == 'letter'</attribute>
            </xpath>

            <!-- Hide tabs -->
            <xpath expr="//page[@name='optional_products']" position="attributes">
                <attribute name="invisible">quotation_type == 'letter'</attribute>
            </xpath>
            <xpath expr="//page[@name='other_information']" position="attributes">
                <attribute name="invisible">quotation_type == 'letter'</attribute>
            </xpath>
<!--            <xpath expr="//page[@name='customer_sign']" position="attributes">-->
<!--                <attribute name="invisible">quotation_type == 'letter'</attribute>-->
<!--            </xpath>-->

            <!-- Add letter quotation tab -->
            <xpath expr="//page[@name='optional_products']" position="after">
                <page string="Letter Quotation Lines" name="letter_quotation"
                      invisible="quotation_type != 'letter'">
                    <field name="letter_order_line">
                        <tree editable="bottom">
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="product_uom_qty"/>
                            <field name="price_unit"/>
                            <field name="price_subtotal" readonly="1"/>
                        </tree>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
