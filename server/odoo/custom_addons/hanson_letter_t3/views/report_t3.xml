<odoo>
    <template id="report_saleorder_document_inherit_letter" inherit_id="sale.report_saleorder_document">
        <!-- Insert Dear + Subject before the page body; only display for letter quotations -->
        <xpath expr="//div[contains(@class,'page')]" position="before">
            <t t-foreach="docs" t-as="o">
                <t t-if="o.quotation_type == 'letter'">
                    <div style="margin-bottom: 30px;">
                        <p><strong>Dear </strong><t t-esc="o.partner_id.name"/></p>
                        <p style="font-size:30px; font-weight:900; text-decoration:underline;">
                            <strong>Subject:</strong> <t t-esc="o.subject"/>
                        </p>
                    </div>
                </t>
            </t>
        </xpath>
        <!-- Hide the original order lines table for letter quotations -->
        <xpath expr="//table" position="attributes">
            <attribute name="t-if">o.quotation_type != 'letter'</attribute>
        </xpath>
        <!-- Insert custom letter quotation table after the original table -->
        <xpath expr="//table" position="after">
            <t t-if="o.quotation_type == 'letter'">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Description</th>
                            <th class="text-right">Quantity</th>
                            <th class="text-right">Unit Price</th>
                            <th class="text-right">Taxes</th>
                            <th class="text-right">Tax excl</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.letter_line_ids" t-as="line">
                            <tr t-if="line.display_type == 'line_section'">
                                <td colspan="6" style="font-weight:bold; font-size: 16px; border-top: 2px solid #000;">
                                    <t t-esc="line.name"/>
                                </td>
                            </tr>
                            <tr t-if="not line.display_type">
                                <td>
                                    <t t-esc="line.product_id.display_name"/>
                                </td>
                                <td>
                                    <t t-esc="line.name"/>
                                </td>
                                <td class="text-right">
                                    <t t-esc="line.product_uom_qty"/>
                                </td>
                                <td class="text-right">
                                    <t t-esc="line.price_unit"/>
                                </td>
                                <td class="text-right">
                                    <t t-esc="', '.join([tax.display_name for tax in line.tax_id])"/>
                                </td>
                                <td class="text-right">
                                    <t t-esc="line.price_subtotal"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </xpath>
    </template>
</odoo>
