<odoo>

    <!-- Upload Quotation & Contract Wizard -->
    <record id="view_crm_lead_dms_upload_wizard_form" model="ir.ui.view">
        <field name="name">crm.lead.dms.upload.wizard.form</field>
        <field name="model">crm.lead.dms.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Documents">
                <sheet>

                    <!-- hidden but required -->
                    <field name="lead_id" invisible="1"/>

                    <group string="Quotation">
                        <field name="quotation_file" filename="quotation_filename"/>
                        <field name="quotation_filename" invisible="1"/>
                    </group>

                    <group string="Contract">
                        <field name="contract_file" filename="contract_filename"/>
                        <field name="contract_filename" invisible="1"/>
                    </group>

                </sheet>

                <footer>
                    <button name="action_upload"
                            string="Upload"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
