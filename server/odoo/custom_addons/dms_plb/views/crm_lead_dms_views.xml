<odoo>

    <record id="view_crm_lead_dms_tree" model="ir.ui.view">
        <field name="name">crm.lead.dms.tree</field>
        <field name="model">crm.lead.dms</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="document_type"/>
                <field name="lead_id"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="view_crm_lead_dms_form" model="ir.ui.view">
        <field name="name">crm.lead.dms.form</field>
        <field name="model">crm.lead.dms</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="lead_id"/>
                        <field name="name"/>
                        <field name="document_type"/>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
