<odoo>
    <record id="view_users_form_inherit_custom_portal" model="ir.ui.view">
        <field name="name">res.users.form.inherit.custom.portal</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!-- Masukkan field selepas Email -->
            <xpath expr="//group[@name='preferences']" position="inside">
                <field name="user_type"/>
            </xpath>
        </field>
    </record>
</odoo>
