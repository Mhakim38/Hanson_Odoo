<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================ -->
    <!--  Tree (List) View for Booking List           -->
    <!-- ============================================ -->
    <record id="view_res_booking_list_tree" model="ir.ui.view">
        <field name="name">res.booking.list.tree</field>
        <field name="model">res.booking.list</field>
        <field name="arch" type="xml">
            <tree string="Booking List" default_order="booking_date desc">
                <field name="booking_number"/>
                <field name="booking_date"/>
                <field name="slot_date"/>
                <field name="slot_id"/>
                <field name="slot_time"/>
                <field name="criteria_id"/>
                <field name="gate"/>
                <field name="depot_id_from"/>
                <field name="depot_id_to"/>
                <field name="container_id"/>
                <field name="transporter_id"/>
                <field name="vehicle_id"/>
                <field name="trailer_id"/>
                <field name="driver_id"/>
                <field name="booking_type"/>
                <field name="booking_status"/>
            </tree>
        </field>
    </record>

    <!-- ============================================ -->
    <!--  Form View for Booking List                  -->
    <!-- ============================================ -->
    <record id="view_res_booking_list_form" model="ir.ui.view">
        <field name="name">res.booking.list.form</field>
        <field name="model">res.booking.list</field>
        <field name="arch" type="xml">
            <form string="Booking List">
                <header>
                    <button name="action_download_qr" type="object" string="Download QR" class="btn-primary" modifiers="{'invisible': [['qr_code', '=', False], ['qr_url', '=', False]]}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="booking_number"/>
                            <field name="booking_date"/>
                            <field name="booking_type"/>
                            <field name="booking_status"/>
                        </group>
                        <group>
                            <field name="slot_date"/>
                            <field name="slot_id"/>
                            <field name="slot_time" readonly="1"/>
                            <field name="criteria_id" readonly="1"/>
                            <field name="gate" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Transport Details">
                            <group>
                                <group>
                                    <field name="depot_id_from"/>
                                    <field name="depot_id_to"/>
                                    <field name="container_id"/>
                                    <field name="transporter_id"/>
                                </group>
                                <group>
                                    <field name="vehicle_id"/>
                                    <field name="trailer_id"/>
                                    <field name="driver_id"/>
                                </group>
                            </group>
                        </page>

                        <!-- New QR page to display generated QR immediately after create -->
                        <page string="QR">
                            <group>
                                <field name="qr_code" widget="image" options="{'size': 300}"/>
                                <group>
                                    <field name="qr_code_name" readonly="1"/>
                                    <field name="qr_url" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================ -->
    <!--  Action for Booking List                     -->
    <!-- ============================================ -->
    <record id="action_res_booking_list" model="ir.actions.act_window">
        <field name="name">Booking List</field>
        <field name="res_model">res.booking.list</field>
        <field name="view_mode">tree,form</field>
    </record>


</odoo>
