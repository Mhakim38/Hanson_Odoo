<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_container_journey_form" model="ir.ui.view">
        <field name="name">res.container.journey.form</field>
        <field name="model">res.container.journey</field>
        <field name="arch" type="xml">
            <form string="Container Journey">
                <sheet>

                    <!-- Top Section -->
                    <group>
                        <group>
                            <field name="container_id"/>
                        </group>
                        <group>
                            <field name="transporter_id"/>
                        </group>
                    </group>

                    <!-- Notebook -->
                    <notebook>
                        <page string="Booking List">
                            <field name="booking_list_ids">
                                <tree editable="bottom">
                                    <field name="booking_date"/>
                                    <field name="booking_number"/>
                                    <field name="slot_id"/>
                                    <field name="booking_type"/>
                                    <field name="depot_id_from"/>
                                    <field name="depot_id_to"/>
                                    <field name="container_id"/>
                                    <field name="transporter_id"/>
                                    <field name="vehicle_id"/>
                                    <field name="trailer_id"/>
                                    <field name="driver_id"/>
                                    <field name="booking_status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree view for main journey -->
    <record id="view_res_container_journey_tree" model="ir.ui.view">
        <field name="name">res.container.journey.tree</field>
        <field name="model">res.container.journey</field>
        <field name="arch" type="xml">
            <tree string="Container Journeys">
                <field name="container_id"/>
                <field name="transporter_id"/>
            </tree>
        </field>
    </record>

    <record id="action_res_container_journey" model="ir.actions.act_window">
        <field name="name">Container Journeys</field>
        <field name="res_model">res.container.journey</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
