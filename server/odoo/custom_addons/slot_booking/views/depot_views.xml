<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_depot_tree" model="ir.ui.view">
        <field name="name">res.depot.tree</field>
        <field name="model">res.depot</field>
        <field name="arch" type="xml">
            <tree>
                <field name="company_name"/>
                <field name="name"/>
                <field name="depot_id"/>
                <field name="location"/>
                <field name="depot_manager_id"/>
                <field name="max_yard_capacity"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_res_depot_form" model="ir.ui.view">
        <field name="name">res.depot.form</field>
        <field name="model">res.depot</field>
        <field name="arch" type="xml">
            <form string="Depot">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" string="Company Name"/>
                            <field name="name"/>
                            <field name="depot_id"/>
                            <field name="location"/>
                            <field name="gps_coordinates"/>
                            <field name="operating_hours"/>
                            <field name="max_yard_capacity"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="depot_manager_id"/>
                            <field name="contact_number"/>
                            <field name="remarks"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Yards">
                            <field name="yard_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="yard_code"/>
                                    <field name="block"/>
                                    <field name="capacity"/>
                                    <field name="occupied_slots"/>
                                    <field name="available_slots" readonly="1"/>
                                    <field name="yard_status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_res_depot" model="ir.actions.act_window">
        <field name="name">Depots</field>
        <field name="res_model">res.depot</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
