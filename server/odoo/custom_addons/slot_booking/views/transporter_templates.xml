<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="transporters_template" name="Transporters List">
        <t t-call="website.layout">
            <div class="container">
                <h1>Transporters</h1>
                <div class="row">
                    <t t-if="not transporters">
                        <p>No transporters found.</p>
                    </t>
                    <t t-foreach="transporters" t-as="trans">
                        <div class="col-md-4">
                            <div class="card mb-3">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <a t-att-href="'/slot_booking/transporters/' + str(trans.id)">
                                            <t t-esc="trans.name.display_name if trans.name else ''"/>
                                        </a>
                                    </h5>
                                    <p class="card-text"><strong>Code:</strong> <t t-esc="trans.transporter_code or '—'"/></p>
                                    <p class="card-text"><strong>Contact:</strong> <t t-esc="trans.contact_number or '—'"/></p>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <template id="transporter_detail_template" name="Transporter Detail">
        <t t-call="website.layout">
            <div class="container">
                <a href="/slot_booking/transporters">&#8592; Back to list</a>
                <h1><t t-esc="transporter.name.display_name if transporter.name else ''"/></h1>
                <p><strong>Code:</strong> <t t-esc="transporter.transporter_code or '—'"/></p>
                <p><strong>Contact:</strong> <t t-esc="transporter.contact_number or '—'"/></p>
                <p><strong>Email:</strong> <t t-esc="transporter.email or '—'"/></p>
                <h3>Drivers</h3>
                <t t-if="not transporter.driver_ids">
                    <p>No drivers recorded.</p>
                </t>
                <t t-foreach="transporter.driver_ids" t-as="d">
                    <div>
                        <t t-esc="d.name.display_name if d.name else ''"/>
                        <t t-if="d.driver_license_no"> — <t t-esc="d.driver_license_no"/></t>
                    </div>
                </t>

                <h3>Vehicles</h3>
                <t t-if="not transporter.vehicle_ids">
                    <p>No vehicles recorded.</p>
                </t>
                <t t-foreach="transporter.vehicle_ids" t-as="v">
                    <div><t t-esc="v.name"/> — <t t-esc="v.vehicle_plate_no or '—'"/></div>
                </t>

                <h3>Trailers</h3>
                <t t-if="not transporter.trailer_ids">
                    <p>No trailers recorded.</p>
                </t>
                <t t-foreach="transporter.trailer_ids" t-as="tr">
                    <div><t t-esc="tr.name"/> — <t t-esc="tr.trailer_plate_no or '—'"/></div>
                </t>
            </div>
        </t>
    </template>
</odoo>
