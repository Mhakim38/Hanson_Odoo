<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Yard List View -->
    <record id="view_res_yard_tree" model="ir.ui.view">
        <field name="name">res.yard.tree</field>
        <field name="model">res.yard</field>
        <field name="arch" type="xml">
            <tree string="Yards">
                <field name="yard_code"/>
                <field name="depot_id"/>
                <field name="address"/>
                <field name="block"/>
                <field name="occupied_slots"/>
                <field name="available_slots"/>
                <field name="yard_supervisor_id" string="Supervisor"/>
                <field name="yard_status"/>
            </tree>
        </field>
    </record>

    <!-- Yard Form View -->
    <record id="view_res_yard_form" model="ir.ui.view">
        <field name="name">res.yard.form</field>
        <field name="model">res.yard</field>
        <field name="arch" type="xml">
            <form string="Yard">
                <header>
                    <!-- ✅ New Geo Button -->
                    <button name="action_geolocate"
                            type="object"
                            string="📍 Get Coordinates"
                            class="btn-primary"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="yard_code"/>
                            <field name="depot_id"/>
                            <field name="address"/>
                            <field name="block"/>
                            <field name="yard_supervisor_id"/>
                            <field name="yard_status"/>
                        </group>

                        <group>
                            <field name="capacity"/>
                            <field name="occupied_slots"/>
                            <field name="available_slots" readonly="1"/>
                            <field name="remarks"/>
                        </group>
                    </group>

                    <!-- ✅ New Geo Section -->
                    <group string="Geo Localization">
                        <group>
                            <field name="partner_latitude" readonly="1"/>
                            <field name="partner_longitude" readonly="1"/>
                            <field name="date_localization" readonly="1"/>
                        </group>
                        <group>
                            <field name="map_url" widget="url" string="View on Map" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_res_yard" model="ir.actions.act_window">
        <field name="name">Yards</field>
        <field name="res_model">res.yard</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
