<odoo>

  <!-- Visitor Registration -->
  <template id="visitor_form_template" name="Visitor Form">
    <t t-call="website.layout">
      <t t-call="visitor_mgmt.portal_navbar"/>
      <div class="oe_structure oe_empty"/>
      <div class="container my-5">
        <div class="row justify-content-center">
          <div class="col-lg-7 col-md-9">
            <div class="card shadow-lg border-0">
              <div class="card-header bg-primary text-white text-center">
                <h2 class="mb-0">Visitor Registration</h2>
              </div>
              <div class="card-body">

                <!-- Error Display -->
                <t t-if="error">
                  <div class="alert alert-danger"><t t-esc="error"/></div>
                </t>

                <!-- If user has no linked units -->
                <t t-if="not units">
                  <div class="alert alert-warning text-center">
                    You don't have any registered property units. Please contact the management office.
                  </div>
                </t>

                <t t-if="units">
                  <form action="/estate/visit/submit" method="post" class="o_form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <!-- Hidden visitor_id to be filled when an existing visitor is found -->
                    <input type="hidden" name="visitor_id" id="visitor_id" value=""/>

                    <!-- ID Number (added above Visitor Name) -->
                    <div class="mb-3">
                      <label for="id_number" class="form-label fw-semibold">ID Number</label>
                      <input type="text" id="id_number" name="id_number" class="form-control" placeholder="Enter ID number (IC / Passport / License)" autocomplete="off" required="required"/>
                      <div id="id_lookup_feedback" class="form-text text-muted small">Enter ID number to auto-fill visitor name.</div>
                    </div>

                    <!-- Visitor Name -->
                    <div class="mb-3">
                      <label for="visitor_name" class="form-label fw-semibold">Visitor Name</label>
                      <input type="text" id="visitor_name" name="visitor_name" class="form-control form-control-lg" placeholder="Enter full name" required="required"/>
                    </div>

                    <!-- Unit -->
                   <div class="mb-3">
                    <label for="unit_id" class="form-label fw-semibold">Select Unit</label>
                    <select name="unit_id" class="form-select form-select-lg" required="required">
                      <option disabled="disabled" selected="selected" value="">Select your unit</option>
                      <t t-foreach="units" t-as="u">
                        <option t-att-value="u.id">
                          <t t-esc="u.display_name"/>
                          <t t-if="u.street"> (<t t-esc="u.street"/>)</t>
                        </option>
                      </t>
                    </select>
                  </div>

                  <!-- Purpose (matches visit.py selection) -->
                  <div class="mb-3">
                    <label for="purpose" class="form-label fw-semibold">Visitor Type</label>
                    <select name="purpose" id="purpose" class="form-select" required="required">
                      <option disabled="disabled" selected="selected" value="">Please select visitor type</option>
                      <option value="visitor">Visitor</option>
                      <option value="pickup">Pickup</option>
                      <option value="contractor/service provider">Contractor/Service Provider</option>
                    </select>
                  </div>

                    <!-- Vehicle -->
                    <div class="mb-3">
                      <label for="vehicle_no" class="form-label fw-semibold">Vehicle No</label>
                      <input type="text" id="vehicle_no" name="vehicle_no" class="form-control" placeholder="Enter vehicle registration number (or NA)" pattern="^[A-Za-z0-9\s/-]{1,30}$" title="Letters, numbers, spaces, slashes or hyphens allowed; will be normalized to uppercase without spaces" maxlength="30"/>
                    </div>

                    <!-- Schedule -->
                    <div class="row mb-4">
                      <div class="col">
                        <label for="schedule_from" class="form-label fw-semibold">Schedule From</label>
                        <input type="datetime-local" name="schedule_from" class="form-control" required="required"/>
                      </div>
                    </div>

                    <!-- Submit -->
                    <div class="d-grid">
                      <button type="submit" class="btn btn-primary btn-lg">Submit</button>
                    </div>
                  </form>
                </t>

              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- JS: lookup visitor by ID number and populate name (make readonly when found) -->
      <script type="text/javascript"><![CDATA[
        (function () {
          function debounce(fn, wait) {
            var t;
            return function () {
              var ctx = this, args = arguments;
              clearTimeout(t);
              t = setTimeout(function () { fn.apply(ctx, args); }, wait || 300);
            };
          }

          function setFeedback(msg, isError) {
            var el = document.getElementById('id_lookup_feedback');
            if (!el) return;
            el.textContent = msg;
            el.classList.remove('text-danger','text-success');
            if (isError) el.classList.add('text-danger');
            else el.classList.add('text-success');
          }

          var idInput = document.getElementById('id_number');
          var nameInput = document.getElementById('visitor_name');
          var hiddenVisitor = document.getElementById('visitor_id');

          if (!idInput || !nameInput) return;

          var lookup = debounce(function () {
            var val = idInput.value && idInput.value.trim();
            if (!val) {
              // clear
              hiddenVisitor.value = '';
              nameInput.readOnly = false;
              setFeedback('Enter ID number to auto-fill visitor name.', false);
              return;
            }
            var url = '/estate/visitor_lookup?id_number=' + encodeURIComponent(val);
            fetch(url, { credentials: 'same-origin' })
              .then(function (r) { return r.json(); })
              .then(function (data) {
                if (data && data.id) {
                  hiddenVisitor.value = data.id;
                  nameInput.value = data.name || '';
                  nameInput.readOnly = true;
                  setFeedback('Existing visitor loaded.', false);
                } else {
                  hiddenVisitor.value = '';
                  nameInput.readOnly = false;
                  setFeedback('No existing visitor found. You can enter a name to create a new visitor.', false);
                }
              })
              .catch(function (err) {
                console.error('Visitor lookup failed', err);
                setFeedback('Lookup failed. Please try again.', true);
                hiddenVisitor.value = '';
                nameInput.readOnly = false;
              });
          }, 350);

          idInput.addEventListener('input', lookup);
          idInput.addEventListener('change', lookup);
          idInput.addEventListener('blur', lookup);

          // Vehicle number formatter: remove spaces and force uppercase as user types
          var vehicleInput = document.getElementById('vehicle_no');
          if (vehicleInput) {
            function formatVehicle() {
              var v = vehicleInput.value || '';
              // remove any character except letters, digits and hyphen, then uppercase
              var newv = v.replace(/[^A-Za-z0-9-]+/g, '').toUpperCase();
              if (newv !== v) {
                // try to preserve caret position as best-effort
                var pos = vehicleInput.selectionStart || 0;
                vehicleInput.value = newv;
                try { vehicleInput.setSelectionRange(pos, pos); } catch (err) { /* ignore */ }
              }
            }
            vehicleInput.addEventListener('input', formatVehicle);
            vehicleInput.addEventListener('blur', formatVehicle);
          }
         })();
      ]]></script>

    </t>
  </template>

  <!-- Thank You Page -->
  <template id="visitor_form_thanks" name="Thank You">
    <t t-call="website.layout">
      <div class="container my-5">
        <div class="row justify-content-center">
          <div class="col-lg-6 col-md-8 text-center">
            <div class="card shadow-sm border-0">
              <div class="card-body">
                <h2 class="text-success mb-3">Thank you!</h2>

                <!-- Load the visit record (safe): ensure integer id and fallback to False -->
                <t t-set="visit" t-value="request.env['estate.visit'].sudo().browse(int(visit_id)) if visit_id else False"/>

                <p class="lead mb-4">Your visit has been successfully logged for <strong><t t-esc="host_name"/></strong>.</p>

                <!-- QR Widget: thumbnail, modal preview, and download button -->
                <t t-set="_qr_url" t-value="qr_data_url or (visit and visit.qr_image and 'data:image/png;base64,%s' % visit.qr_image) or False"/>
                <t t-if="_qr_url">
                  <div class="mb-3 text-center">
                    <a href="#" role="button" data-bs-toggle="modal" data-bs-target="#qrModal" aria-label="View QR Code">
                      <img t-att-src="_qr_url" alt="QR Code" class="img-fluid rounded shadow-sm" style="max-width:220px;"/>
                    </a>
                    <div class="mt-2">
                      <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#qrModal">View</button>
                    </div>
                  </div>

                  <!-- Modal: QR preview -->
                  <div class="modal fade" id="qrModal" tabindex="-1" aria-labelledby="qrModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                      <div class="modal-content">
                        <div class="modal-header">
                          <h5 class="modal-title" id="qrModalLabel">QR Code</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"><span class="visually-hidden">Close</span></button>
                        </div>
                        <div class="modal-body text-center">
                          <img t-att-src="_qr_url" alt="QR Code" class="img-fluid" style="max-width:320px;"/>
                        </div>
                        <div class="modal-footer">
                          <a t-att-href="_qr_url" class="btn btn-primary" download="visit_qr.png">Download</a>
                          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                      </div>
                    </div>
                  </div>
                </t>

                <!-- Visit details using fields from the estate.visit model -->
                <t t-if="visit and visit.id">
                  <p><strong>Date:</strong> <span t-field="visit.schedule_from"/></p>
                  <p><strong>Visitor Name:</strong> <t t-esc="visit.visitor_id.name"/></p>
                  <p><strong>Unit Number:</strong> <t t-esc="visit.unit_id.display_name"/></p>
                </t>
                <t t-if="not visit or not visit.id">
                  <p><strong>Date:</strong> <t t-esc="schedule_from"/></p>
                  <p><strong>Visitor Name:</strong> <t t-esc="visitor_name"/></p>
                  <p><strong>Unit Number:</strong> <t t-esc="unit_name"/></p>
                </t>

                <div class="d-flex justify-content-center gap-2 mt-3">
                  <a href="/estate/visit" class="btn btn-outline-primary">Register Another Visitor</a>
                  <a href="/portal/visitor-log" class="btn btn-outline-secondary">Visit Log</a>
                </div>

              </div>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>

</odoo>
