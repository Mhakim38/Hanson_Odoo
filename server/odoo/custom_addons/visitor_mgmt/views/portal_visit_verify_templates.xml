<odoo>
  <!-- ✅ QR Valid Page -->
  <template id="qr_verify_template" name="Visitor QR Verification Page">
    <t t-call="website.layout">
      <div class="container my-5">
        <div class="card shadow-lg border-0">
          <div class="card-header bg-primary text-white text-center">
            <h2>Visitor Verification</h2>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-6">
                <h5>Visitor Details</h5>
                <p><strong>Name:</strong> <t t-esc="visit.visitor_id.name"/></p>
                <p><strong>Purpose:</strong> <t t-esc="visit.purpose or '-'"/></p>
                <p><strong>Host:</strong> <t t-esc="visit.host_id.name"/></p>
                <p><strong>Unit:</strong> <t t-esc="visit.unit_id.display_name"/></p>
              </div>
              <div class="col-md-6 text-center">
                <h5>Badge / QR Info</h5>
                <p><strong>Badge No:</strong> <t t-esc="visit.badge_no or '-'"/></p>
                <p><strong>QR Token:</strong> <t t-esc="visit.qr_token or '-'"/></p>
                <img t-if="visit.qr_image" t-att-src="'data:image/png;base64,%s' % (visit.qr_image)" class="img-fluid rounded shadow mt-3" style="max-width:200px;"/>
              </div>
            </div>
            <hr/>
            <div class="text-center">
              <t t-set="state_label" t-value="visit._fields['state'].convert_to_export(visit.state, visit)"/>
              <span t-attf-class="badge
                #{'bg-secondary' if visit.state == 'draft' else ''}
                #{'bg-info' if visit.state == 'scheduled' else ''}
                #{'bg-success' if visit.state == 'check_in' else ''}
                #{'btn btn-warning' if visit.state == 'check_out' else ''}
                #{'bg-danger' if visit.state == 'cancel' else ''}">
                <t t-esc="state_label"/>
              </span>
              <p class="mt-2 mb-0 text-muted">Valid until <t t-esc="visit.qr_expiry or 'N/A'"/></p>
            </div>
              <div class="d-flex justify-content-between align-items-center">
              <!-- Left side buttons -->
              <div>
                <a href="/visitor/scan" class="btn btn-info btn-md ms-2" role="button">Scanner</a>
                <a href="/guard/visitors" class="btn btn-danger btn-md ms-2" role="button">Close</a>
              </div>

              <!-- Right side (Check In / Check Out) -->
              <div>
                <form action="/visitor/action" method="post" class="d-inline-block ms-2">
                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                  <input type="hidden" name="visit_id" t-att-value="visit.id"/>
                  <input type="hidden" name="action_type" value="check_in"/>
                  <button type="submit" class="btn btn-success btn-md">Check In</button>
                </form>

                <form action="/visitor/action" method="post" class="d-inline-block ms-2">
                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                  <input type="hidden" name="visit_id" t-att-value="visit.id"/>
                  <input type="hidden" name="action_type" value="check_out"/>
                  <button type="submit" class="btn btn-warning btn-md">Check Out</button>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>

  <!-- ❌ Invalid QR -->
  <template id="qr_invalid_template" name="Invalid QR Page">
    <t t-call="website.layout">
      <div class="container my-5 text-center">
        <div class="alert alert-danger shadow">
          <h4 class="alert-heading">Invalid or Expired QR Code</h4>
          <p>Please contact the resident or management for assistance.</p>
        </div>
      </div>
    </t>
  </template>

  <!-- Visitor info page (when a visitor QR is scanned) -->
  <template id="visitor_info_template" name="Visitor Info Page">
    <t t-call="website.layout">
      <div class="container my-5">
        <div class="card shadow border-0">
          <div class="card-header bg-primary text-white text-center">
            <h3>Visitor Details</h3>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-6">
                <p><strong>Name:</strong> <t t-esc="visitor.name"/></p>
                <p><strong>Phone:</strong> <t t-esc="visitor.phone or '-'"/></p>
                <p><strong>ID Type:</strong> <t t-esc="visitor.id_type or '-'"/></p>
                <p><strong>ID Number:</strong> <t t-esc="visitor.id_number or '-'"/></p>
                <p><strong>Notes:</strong> <t t-esc="visitor.notes or '-'"/></p>
              </div>
              <div class="col-md-6 text-center">
                <h5>QR</h5>
                <img t-if="visitor.qr_image" t-att-src="'data:image/png;base64,%s' % (visitor.qr_image)" class="img-fluid" style="max-width:240px;"/>
                <p class="mt-2 text-muted">Token: <t t-esc="visitor.qr_token or '-'"/></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>

  <!-- Visitor scanner page: opens camera and scans QR codes -->
  <template id="visitor_scan_template" name="Visitor QR Scanner">
    <t t-call="website.layout">
      <div class="container my-5">
        <div class="card shadow border-0">
          <div class="card-header bg-primary text-white text-center">
            <h3>Scan Visitor QR</h3>
          </div>
          <div class="card-body text-center">
            <p>Allow camera access when prompted. The scanner will detect the QR and redirect to the visitor page.</p>

            <div id="qr-reader" style="width:100%; max-width:500px; margin:0 auto;"></div>
            <div id="qr-result" class="mt-3"></div>

            <div class="mt-3">
              <button id="btn-stop" class="btn btn-danger d-none">Stop Scanner</button>
              <a href="/" class="btn btn-secondary">Close</a>
            </div>

            <!-- Load html5-qrcode from CDN -->
            <script src="https://unpkg.com/html5-qrcode@2.3.7"></script>
            <script type="text/javascript"><![CDATA[
              (function () {
                var resultEl = document.getElementById('qr-result');
                var btnStop = document.getElementById('btn-stop');
                var lastResult = null;

                function handleScan(decodedText, decodedResult) {
                  if (!decodedText || decodedText === lastResult) {
                    return;
                  }
                  lastResult = decodedText;
                  resultEl.innerHTML = '<div class="alert alert-success">Scanned: ' + decodedText + '</div>';

                  // If the scanned text is a full URL, navigate to it.
                  if (/^https?:\/\//i.test(decodedText) || decodedText.indexOf('/') === 0) {
                    window.location.href = decodedText;
                    return;
                  }

                  // Otherwise assume it's a token; try redirect to visitor/verify first, then visitor/info
                  var tryUrl = '/visitor/verify/' + encodeURIComponent(decodedText);
                  window.location.href = tryUrl;
                }

                var html5QrcodeScanner = new Html5Qrcode(/* element id */ "qr-reader");

                Html5Qrcode.getCameras().then(function(cameras) {
                  if (cameras && cameras.length) {
                    var cameraId = cameras[0].id;
                    html5QrcodeScanner.start(
                      cameraId,
                      { fps: 10, qrbox: 250 },
                      handleScan
                    ).then(function() {
                      btnStop.classList.remove('d-none');
                    }).catch(function(err){
                      resultEl.innerHTML = '<div class="alert alert-danger">Unable to start camera: ' + err + '</div>';
                    });
                  } else {
                    resultEl.innerHTML = '<div class="alert alert-warning">No camera found</div>';
                  }
                }).catch(function(err){
                  resultEl.innerHTML = '<div class="alert alert-danger">Error accessing cameras: ' + err + '</div>';
                });

                btnStop.addEventListener('click', function(){
                  html5QrcodeScanner.stop().then(function() {
                    btnStop.classList.add('d-none');
                    resultEl.innerHTML = '<div class="alert alert-info">Scanner stopped.</div>';
                  }).catch(function(err){
                    resultEl.innerHTML = '<div class="alert alert-danger">Failed to stop scanner: ' + err + '</div>';
                  });
                });
              })();
            ]]></script>

          </div>
        </div>
      </div>
    </t>
  </template>

</odoo>
