<odoo>
  <!-- Actions must be defined BEFORE menus -->
  <record id="action_estate_visitor_vehicle" model="ir.actions.act_window">
    <field name="name">Visitors Vehicle</field>
    <field name="res_model">estate.visitor.vehicle</field>
    <field name="view_mode">tree,form</field>
  </record>

  <record id="action_estate_visitor" model="ir.actions.act_window">
    <field name="name">Visitors</field>
    <field name="res_model">estate.visitor</field>
    <field name="view_mode">tree,form</field>
  </record>

  <record id="action_estate_visit" model="ir.actions.act_window">
    <field name="name">Visits Log</field>
    <field name="res_model">estate.visit</field>
    <field name="view_mode">tree,form</field>
  </record>

  <record id="action_estate_gate" model="ir.actions.act_window">
    <field name="name">Gates</field>
    <field name="res_model">estate.gate</field>
    <field name="view_mode">tree,form</field>
  </record>

  <!-- Now define menu items -->
  <menuitem id="menu_security_root" name="Visitors" parent="estate_core.menu_estate_root" sequence="20"/>

  <menuitem id="menu_security_visitors" name="Visitors" parent="menu_security_root" action="action_estate_visitor" sequence="2"/>
  <menuitem id="menu_security_visitors_vehicle" name="Visitors Vehicle" parent="menu_security_root" action="action_estate_visitor_vehicle" sequence="3"/>
  <menuitem id="menu_security_visits" name="Visits Log" parent="menu_security_root" action="action_estate_visit" sequence="1"/>
  <menuitem id="menu_security_gates" name="Gates" parent="menu_security_root" action="action_estate_gate" sequence="4"/>
</odoo>
