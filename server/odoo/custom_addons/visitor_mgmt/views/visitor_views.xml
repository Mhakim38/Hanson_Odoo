<odoo>
  <record id="view_estate_visitor_tree" model="ir.ui.view">
    <field name="name">estate.visitor.tree</field>
    <field name="model">estate.visitor</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="id_type"/>
        <field name="id_number"/>
        <field name="phone"/>
        <field name="blacklisted"/>
      </tree>
    </field>
  </record>

  <record id="view_estate_visitor_form" model="ir.ui.view">
    <field name="name">estate.visitor.form</field>
    <field name="model">estate.visitor</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="id_type"/>
            <field name="id_number"/>
            <field name="phone"/>
            <field name="blacklisted"/>
          </group>
          <group>
            <field name="notes"/>
          </group>

<!--          <group string="QR">-->
<!--            <field name="qr_image" widget="image" class="oe_avatar" options="{'preview_image': 'qr_image'}"/>-->
<!--            <field name="qr_token" readonly="1"/>-->
<!--            <button name="action_regenerate_qr" type="object" string="Regenerate QR" class="oe_highlight"/>-->
<!--          </group>-->

        </sheet>
      </form>
    </field>
  </record>
</odoo>
