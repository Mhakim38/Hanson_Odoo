<odoo>
  <record id="view_estate_gate_tree" model="ir.ui.view">
    <field name="name">estate.gate.tree</field>
    <field name="model">estate.gate</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="location_gps"/>
        <field name="property_id"/>
      </tree>
    </field>
  </record>

  <record id="view_estate_gate_form" model="ir.ui.view">
    <field name="name">estate.gate.form</field>
    <field name="model">estate.gate</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="location_gps"/>
            <field name="property_id"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
