<odoo>
    <record id="view_hr_employee_form_plb_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.plb.behavior</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Insert behavior fields immediately after work_email so they're visible to non-HR users -->
            <xpath expr="//form//field[@name='work_email']" position="after">
                    <field name="initial"/>
            </xpath>
        </field>
    </record>
</odoo>

