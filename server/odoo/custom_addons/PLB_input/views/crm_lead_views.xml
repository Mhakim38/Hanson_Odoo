<odoo>
    <!-- Custom Form View -->
    <record id="view_crm_lead_form_custom" model="ir.ui.view">
        <field name="name">crm.lead.form.custom</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- Existing info before the notebook -->
            <xpath expr="//sheet/notebook" position="before">
                <group colspan="2">
                    <group string="Contract Details">
                        <field name="contract_type" widget="radio"/>
                        <field name="contract_months"/>
                        <field name="expected_start_date"/>
                        <field name="date_go_live"/>
                        <field name="date_conversion"/>
                    </group>

                    <group string="Service Information">
                        <field name="scope_of_service"/>
                        <field name="freight_type" invisible="scope_of_service != 'freight_forwarding'"/>
                        <field name="origin_country_id"/>
                        <field name="destination_country_id"/>
                        <field name="port_of_loading_id"/>
                        <field name="port_of_destination_id"/>
                        <field name="product"/>
                    </group>
                </group>

                <group colspan="2">
                    <group string="Additional Info">
                        <field name="dept_region"/>
                        <field name="realized_revenue_fy2025"/>
                        <field name="category_type"/>
                    </group>
                </group>
            </xpath>

            <!-- ✅ Fixed "Activities" tab -->
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Activities">
                    <field name="activity_ids" widget="mail_activity" nolabel="1"/>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Custom Tree View -->
    <record id="view_crm_lead_tree_custom" model="ir.ui.view">
        <field name="name">crm.lead.tree.custom</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="field[@name='partner_id']" position="replace">
                <field name="team_id" invisible="1" optional="show"/>
                <field name="name" string="Project" optional="show"/>
                <field name="description" string="Remarks" optional="show"/>
                <field name="user_id" string="PIC" optional="show"/>
                <field name="create_date" string="Date Funnel" optional="show"/>
                <field name="expected_start_date" string="Expected Start Date" optional="show"/>
                <field name="date_conversion" string="Date Secured" optional="show"/>
                <field name="date_go_live" string="Date Go Live" optional="show"/>
                <field name="scope_of_service" string="Scope of service" optional="show"/>
                <field name="product" string="Product" optional="show"/>
                <field name="dept_region" string="Dept/region" optional="show"/>
                <field name="realized_revenue_fy2025" optional="show"/>
                <field name="category_type" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
