<odoo>
    <!-- New action to open the scheduling wizard as a modal (moved early so views can reference it) -->
    <record id="action_schedule_activity_plb" model="ir.actions.act_window">
        <field name="name">Schedule Activity</field>
        <field name="res_model">mail.activity.schedule</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
                <field name="context">{'default_res_model': 'crm.lead', 'default_res_id': active_id}</field>
    </record>

    <!-- Custom Form View -->
    <record id="view_crm_lead_form_custom" model="ir.ui.view">
        <field name="name">crm.lead.form.custom</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- Add Decline button to the form header -->
            <xpath expr="//form/header" position="inside">
                    <!-- ensure the computed flag is available to header modifiers -->
                <field name="is_decline_stage" invisible="1"/>
                    <field name="is_readonly_stage" invisible="1"/>
                <button name="action_decline" string="Decline" type="object" class="btn-danger" groups="base.group_system"/>
            </xpath>
<!--            <xpath expr="field[@name='priority']" position="attributes">-->
<!--                <attribute name="string">Chance</attribute>-->
<!--            </xpath>-->

            <xpath expr="//field[@name='expected_revenue']" position="attributes">
                <attribute name="string">Value Per Annum</attribute>
            </xpath>

            <!-- Hide Expected Closing (date_deadline) -->
            <xpath expr="//label[@for='date_deadline']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Add Date Funnel (create_date) after Salesperson (user_id) -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="create_date" string="Date Funnel" readonly="1"/>
            </xpath>

            <!-- Hide core Won button when stage is Decline -->
            <xpath expr="//form/header/button[@name='action_set_won_rainbowman']" position="replace" optional="true">
                <!-- 'Won' button removed by PLB_input customisation -->
            </xpath>

            <!-- Hide core Lost buttons when stage is Decline -->
            <xpath expr="//form/header/button[@name='%(crm.crm_lead_lost_action)d']" position="replace" optional="true">
                <!-- 'Lost' button removed by PLB_input customisation -->
            </xpath>

            <!-- Existing info before the notebook -->
            <xpath expr="//sheet/notebook" position="before">
                <group colspan="2">
                    <group string="Contract Details">
                        <field name="contract_type" widget="radio" readonly="is_readonly_stage"/>
                        <field name="contract_months" string="Number of Months" readonly="is_readonly_stage"/>
                        <field name="expected_start_date" readonly="is_readonly_stage"/>
                        <!-- date_secured readonly unless computed boolean is_contract_stage is True -->
                        <field name="date_secured" readonly="not is_contract_stage or is_readonly_stage"/>
                        <!-- date_go_live readonly unless computed boolean is_contract_stage is True -->
                        <field name="date_go_live" readonly="not is_contract_stage or is_readonly_stage"/>
                        <!-- New: inline attachment stored on the lead; editable only in Shortlisted or Verbal stages -->
                        <field name="attachment_file" filename="attachment_filename" readonly="not is_contract_stage or is_readonly_stage"/>
                        <field name="attachment_filename" readonly="1"/>
                        <!-- computed boolean used in modifiers must be present in the view -->
                        <field name="is_contract_stage" invisible="1"/>
                        <!-- computed boolean for final contract/won stage (probability 100) -->
                        <field name="is_final_contract_stage" invisible="1"/>
                        <!-- computed boolean used to hide buttons when the lead is in a Decline stage -->
                        <field name="is_decline_stage" invisible="1"/>
                        <!-- computed boolean used to make fields required/visible when in Qualify -->
                        <field name="is_qualify_stage" invisible="1"/>
                        <!-- computed boolean for Proposal Submitted stage (freight forwarding mandatory) -->
                        <field name="is_proposal_submitted_stage" invisible="1"/>
                        <!-- computed boolean for Contract/Loss stage (readonly) -->
                        <field name="is_readonly_stage" invisible="1"/>
                    </group>

                    <group string="Service Information">
                        <field name="scope_of_service" readonly="is_readonly_stage"/>
                        <field name="freight_type" invisible="scope_of_service != 'freight_forwarding'" readonly="is_readonly_stage"/>
                        <field name="origin_country_id" readonly="is_readonly_stage"/>
                        <field name="destination_country_id" readonly="is_readonly_stage"/>
                        <field name="port_of_loading_id" readonly="is_readonly_stage"/>
                        <field name="port_of_destination_id" readonly="is_readonly_stage"/>
                        <field name="product" readonly="is_readonly_stage"/>
                    </group>
                </group>

                <group colspan="2">
                    <group string="Additional Info">
                        <field name="dept_region" readonly="is_readonly_stage"/>
                        <field name="realized_revenue" readonly="is_readonly_stage"/>
                        <!-- moved fields: remark, operating_profit_margin -->
                        <field name="remark" readonly="is_readonly_stage"/>
                        <field name="operating_profit_margin" widget="percentage" readonly="is_readonly_stage"/>
                        <!-- Quotation attachment required in Qualify and editable in Qualify stage -->
                        <field name="quotation_attachment" filename="quotation_attachment_filename" readonly="is_readonly_stage"/>
                        <field name="quotation_attachment_filename" readonly="1"/>
                        <!-- Hide category_type as requested -->
                        <field name="category_type" invisible="1"/>
                    </group>
                </group>
            </xpath>

            <!-- ✅ Fixed "Activities" tab -->
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Activities">
                    <field name="activity_ids" widget="mail_activity" nolabel="1"/>
                </page>
            </xpath>

            <xpath expr="//label[@for='probability']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='probability']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='probability']" position="after">
                <div style="display:flex; flex-direction:column;" class="mb-2 ms-3">
                    <label for="priority" string="Priority" style="font-weight:bold;" class="mb-1 mt-2"/>
                    <field name="priority" widget="priority" nolabel="1"/>
                </div>
            </xpath>

            <!-- Make partner_id (Customer Name) always available for editing (except in readonly stages) -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">is_readonly_stage</attribute>
            </xpath>

            <!-- Make expected_revenue always available for editing (except in readonly stages) -->
            <xpath expr="//field[@name='expected_revenue']" position="attributes">
                <attribute name="readonly">is_readonly_stage</attribute>
            </xpath>
        </field>
    </record>

    <!-- Custom Tree View -->
    <record id="view_crm_lead_tree_custom" model="ir.ui.view">
        <field name="name">crm.lead.tree.custom</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="field[@name='partner_id']" position="before">
                <field name="row_number"/>
            </xpath>
            <xpath expr="field[@name='priority']" position="before">
                <field name="operating_profit_margin" widget="percentage" optional="show"/>
            </xpath>
            <xpath expr="field[@name='user_id']" position="attributes">
                <attribute name="string">PIC</attribute>
            </xpath>
            <xpath expr="field[@name='priority']" position="attributes">
                <attribute name="string">Chance</attribute>
            </xpath>
            <xpath expr="field[@name='name']" position="attributes">
                <attribute name="string">Initiative/Project Description</attribute>
            </xpath>
            <xpath expr="field[@name='name']" position="after">
                <field name="team_id" invisible="1" optional="show"/>
<!--                <field name="name" string="Project" optional="show"/>-->
<!--                <field name="partner_id" string="Customer" optional="show"/>-->

<!--                <field name="user_id" string="PIC" optional="show"/>-->
<!--                <field name="create_date" string="Date Funnel" optional="show"/>-->
            </xpath>
            <xpath expr="field[@name='stage_id']" position="after">
                <field name="description" string="Remarks/Contract Period/Adhoc" optional="show"/>
            </xpath>
            <xpath expr="field[@name='create_date']" position="after">
                <field name="expected_start_date" string="Expected Start Date" optional="show"/>
                <field name="date_secured" string="Date Secured" optional="show"/>
                <field name="date_go_live" string="Date Go Live" optional="show"/>
                <field name="scope_of_service" string="Scope of Service" optional="show"/>
                <field name="product" string="Product" optional="show"/>
                <field name="dept_region" string="Dept/Region" optional="show"/>
                <field name="realized_revenue" sum="Forecast Revenue for Current Year" optional="show" widget="monetary" options="{'currency_field': 'company_currency'}"/>
                <field name="origin_country_id" optional="show"/>
                <field name="destination_country_id" optional="show"/>
                <field name="port_of_loading_id" optional="show"/>
                <field name="port_of_destination_id" optional="show"/>
            </xpath>
<!--            <xpath expr="//field[@name='create_date']" position="after">-->
<!--                <field name="priority" widget="priority"/>-->
<!--            </xpath>-->
            <xpath expr="//field[@name='probability']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Action + Menu: open mail.activity tree under Sales -->
    <!-- Calendar view for mail.activity (PLB) - compatible with mail.activity fields -->
    <record id="plb_mail_activity_view_calendar" model="ir.ui.view">
        <field name="name">mail.activity.calendar.plb</field>
        <field name="model">mail.activity</field>
        <field name="arch" type="xml">
            <!-- Use date_deadline as the start (and stop) date so calendar can render activities -->
            <calendar string="Activities (PLB)" date_start="date_deadline" date_stop="date_deadline" color="user_id">
                <field name="summary"/>
                <field name="date_deadline"/>
                <field name="user_id"/>
                <field name="partner_id"/>
            </calendar>
        </field>
    </record>

    <record id="action_mail_activity_my_plb" model="ir.actions.act_window">
        <field name="name">My Activities (PLB)</field>
        <field name="res_model">mail.activity</field>
        <!-- Expose calendar view in addition to tree and form. We provide a PLB calendar view
             compatible with `mail.activity` so users can switch to Calendar without
             loading the calendar.event view (which expects different fields). -->
        <field name="view_mode">tree,form,calendar</field>
        <!-- Keep the tree view as the default view_id -->
        <field name="view_id" ref="mail.mail_activity_view_tree"/>
        <field name="search_view_id" ref="mail.mail_activity_view_search"/>
        <!-- Provide explicit view entries so the calendar view appears in the view switcher.
             Note: the referenced calendar view is an external ID and should exist in the
             `calendar` module. We provide a PLB calendar view compatible with `mail.activity`.
         -->
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('mail.mail_activity_view_tree')}), (0, 0, {'view_mode': 'form', 'view_id': ref('mail.mail_activity_view_form')}), (0, 0, {'view_mode': 'calendar', 'view_id': ref('PLB_input.plb_mail_activity_view_calendar')})]"/>
        <field name="domain">[('res_model', '=', 'crm.lead')]</field>
    </record>

    <menuitem id="menu_my_activities_plb"
              name="My Activities (PLB)"
              parent="crm.crm_menu_sales"
              action="PLB_input.action_mail_activity_my_plb"/>

    <!-- Inherit mail.activity tree to add partner column before res_name and user_id after date_deadline -->
    <record id="view_mail_activity_tree_inherit_plb" model="ir.ui.view">
        <field name="name">mail.activity.view.tree.plb.inherit</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_tree"/>
        <field name="arch" type="xml">
            <!-- Change field labels -->
            <xpath expr="//tree/field[@name='activity_type_id']" position="attributes">
                <attribute name="string">How</attribute>
            </xpath>
            <xpath expr="//tree/field[@name='summary']" position="attributes">
                <attribute name="string">What</attribute>
            </xpath>
            <!-- date_deadline label updated to include question mark -->
            <xpath expr="//tree/field[@name='activity_type_id']" position="after">
                <field name="date_deadline" string="When"/>
            </xpath>
            <xpath expr="//tree/field[@name='date_deadline']" position="after">
                <field name="partner_id"/>
                <field name="user_id" string="Sales"/>
            </xpath>
            <xpath expr="//tree/field[@name='res_name']" position="replace"/>

            <xpath expr="//tree/field[@name='partner_id']" position="after">
                <field name="contact_id"/>
            </xpath>
            <xpath expr="//tree/field[@name='contact_id']" position="after">
                <field name="contact_position"/>
            </xpath>
            <xpath expr="//tree/field[@name='summary']" position="after">
                <field name="plb_why"/>
                <field name="plb_week"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit the mail.activity form to allow assigning a Contact on the activity popup -->
    <record id="view_mail_activity_form_inherit_plb" model="ir.ui.view">
        <field name="name">mail.activity.view.form.plb.inherit</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_form"/>
        <field name="arch" type="xml">
            <!-- Change label for the due date field in the activity form -->
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="string">When ?</attribute>
            </xpath>
            <xpath expr="//field[@name='summary']" position="after">
                <field name="contact_id"/>
                <field name="plb_why"/>
            </xpath>
        </field>
    </record>

    <!-- Also add contact_id to the popup form used by the activity widget -->
    <record id="view_mail_activity_form_popup_inherit_plb" model="ir.ui.view">
        <field name="name">mail.activity.view.form.popup.plb.inherit</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_form_popup"/>
        <field name="arch" type="xml">
            <!-- Change label for due date in popup form -->
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="string">When ?</attribute>
            </xpath>
            <xpath expr="//field[@name='summary']" position="after">
                <field name="contact_id"/>
                <field name="plb_why"/>
            </xpath>
        </field>
    </record>

    <!-- Add contact_id to the "without record access" activity form as well -->
    <record id="view_mail_activity_form_without_access_inherit_plb" model="ir.ui.view">
        <field name="name">mail.activity.view.form.without.record.access.plb.inherit</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_form_without_record_access"/>
        <field name="arch" type="xml">
            <!-- Change label for due date in the no-access form -->
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="string">When ?</attribute>
            </xpath>
            <xpath expr="//group" position="inside">
                <field name="contact_id"/>
                <field name="plb_why"/>
            </xpath>
        </field>
    </record>

</odoo>
