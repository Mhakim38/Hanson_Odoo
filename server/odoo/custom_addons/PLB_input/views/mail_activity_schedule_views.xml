<odoo>
    <record id="mail_activity_schedule_view_form_plb_inherit" model="ir.ui.view">
        <field name="name">mail.activity.schedule.form.plb.inherit</field>
        <field name="model">mail.activity.schedule</field>
        <field name="inherit_id" ref="mail.mail_activity_schedule_view_form"/>
        <field name="arch" type="xml">
            <!-- Set field labels in the schedule wizard to How / What / When ? / Sales -->
            <xpath expr="//group[@invisible='plan_id']//field[@name='activity_type_id']" position="attributes">
                <attribute name="string">How</attribute>
            </xpath>
            <xpath expr="//group[@invisible='plan_id']//field[@name='summary']" position="attributes">
                <attribute name="string">What</attribute>
            </xpath>
            <xpath expr="//group[@invisible='plan_id']//field[@name='date_deadline']" position="attributes">
                <attribute name="string">When ?</attribute>
            </xpath>
            <xpath expr="//group[@invisible='plan_id']//field[@name='activity_user_id']" position="attributes">
                <attribute name="string">Sales</attribute>
            </xpath>
            <!-- Insert fields into the activity-based scheduling group -->
            <xpath expr="//group[ancestor::group[@invisible='plan_id']]//field[@name='summary']" position="after">
                <field name="contact_id"/>
                <field name="plb_why"/>
            </xpath>
        </field>
    </record>
<!--
1. how
2. When
3. Who (Company)
4. Who (Contact)
5. Why
6. What
7. Sales
8. Weeks
-->
</odoo>
