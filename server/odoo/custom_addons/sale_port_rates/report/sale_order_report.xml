<odoo>
    <template id="report_saleorder_port_rates" inherit_id="sale.report_saleorder_document">

        <!-- Hide default customer address in top-left -->
        <xpath expr="//div[@id='informations']/div[1]" position="attributes">
            <attribute name="style">display:none;</attribute>
        </xpath>

        <!-- Insert customer address block before main page content -->
        <xpath expr="//div[contains(@class,'page')]" position="before">
            <div style="text-align:left; margin-bottom: 20px;">
                <div t-field="doc.partner_id"
                     t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
            </div>
        </xpath>

        <xpath expr="//div[contains(@class,'page')]" position="replace">
            <div class="page" style="font-size:13px; line-height:1.5;">

                <!-- =============================
                     Header Section (for Letter Type)
                     ============================= -->
                <t t-if="doc.quotation_type == 'letter'">
                    <div style="margin-bottom: 30px;">
                        <p><strong>Dear </strong><t t-esc="doc.partner_id.name"/></p>
                        <p style="font-size:22px; font-weight:700; text-decoration:underline;">
                            <strong>Subject:</strong> <t t-esc="doc.subject"/>
                        </p>
                    </div>
                </t>

                <!-- =============================
                     Title
                     ============================= -->
                <h2 style="text-align:center; margin-top:40px; margin-bottom:20px; font-weight:700;">
                    <t t-if="doc.quotation_type == 'letter'">Letter Quotation</t>
                    <t t-elif="doc.quotation_type == 'port_rate'">Port Rates Quotation</t>
                    <t t-else="">Quotation</t>
                </h2>

                <!-- =============================
                     Date
                     ============================= -->
                <div style="margin-top:20px; margin-bottom:20px;">
                    <p>

                    </p>
                </div>

                <!-- =============================
                     Quotation Information Fields
                     ============================= -->
                <t t-if="doc.quotation_type == 'quotation'">
                    <div class="container w-50 float-end mb-4">
                        <table class="table table-sm table-borderless mb-0" style="width: 100%; border-collapse: collapse;">
                            <tbody>
                                <tr>
                                    <td style="padding: 2px 6px;"><strong>Date</strong></td>
                                    <td style="padding: 2px 6px;">: <span t-field="doc.date_order" t-options="{'format': 'dd/MM/yyyy'}"/></td>
                                </tr>
                                <tr>
                                    <td style="padding: 2px 6px;"><strong>Expiry Date</strong></td>
                                    <td style="padding: 2px 6px;">: <span t-field="doc.validity_date" t-options="{'format': 'dd/MM/yyyy'}"/></td>
                                </tr>
                                <tr>
                                    <td style="padding: 2px 6px;"><strong>Type</strong></td>
                                    <td style="padding: 2px 6px;">: <t t-esc="dict(doc._fields['type_selection'].selection).get(doc.type_selection) or '-'"/></td>
                                </tr>
                                <tr>
                                    <td style="padding: 2px 6px;"><strong>Size</strong></td>
                                    <td style="padding: 2px 6px;">: <t t-esc="dict(doc._fields['size_selection'].selection).get(doc.size_selection) or '-'"/></td>
                                </tr>
                                <tr>
                                    <td style="padding: 2px 6px;"><strong>Mode</strong></td>
                                    <td style="padding: 2px 6px;">: <t t-esc="dict(doc._fields['mode_selection'].selection).get(doc.mode_selection) or '-'"/></td>
                                </tr>
                                <tr>
                                    <td style="padding: 2px 6px;"><strong>Port</strong></td>
                                    <td style="padding: 2px 6px;">: <t t-esc="dict(doc._fields['port_selection'].selection).get(doc.port_selection) or '-'"/></td>
                                </tr>
                                <tr>
                                    <td style="padding: 2px 6px;"><strong>Service Type</strong></td>
                                    <td style="padding: 2px 6px;">: <t t-esc="doc.service_type_id.display_name or '-'"/></td>
                                </tr>
                                <tr>
                                    <td style="padding: 2px 6px;"><strong>Incoterm</strong></td>
                                    <td style="padding: 2px 6px;">: <t t-esc="doc.incoterm_id.display_name or '-'"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>


                <!-- =============================
                     Port Rates Table
                     ============================= -->
                <t t-if="doc.quotation_type == 'port_rate'">
                    <table class="table table-sm table-bordered" style="border-collapse: collapse; width:100%; font-size:12px;">
                        <thead>
                            <tr style="background-color:#f5f5f5; text-align:center;">
                                <th style="border:1px solid #000; padding:5px;">Port</th>
                                <th style="border:1px solid #000; padding:5px;">Validation</th>
                                <th style="border:1px solid #000; padding:5px;">Export Rate</th>
                                <th style="border:1px solid #000; padding:5px;">Inclusive</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.port_order_line_ids" t-as="l">
                                <td style="border:1px solid #000; padding:5px;"><span t-field="l.port"/></td>
                                <td style="border:1px solid #000; padding:5px;"><span t-field="l.validation"/></td>
                                <td style="border:1px solid #000; padding:5px; text-align:right;">
                                    <span t-field="l.export_rate"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                                <td style="border:1px solid #000; padding:5px;"><span t-field="l.inclusive"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>

                <!-- =============================
                     Standard Quotation Table
                     ============================= -->
                <t t-if="doc.quotation_type == 'quotation'">
                    <table class="table table-sm" style="width:100%; font-size:12px;">
                        <thead>
                            <tr>
                                <th>Product / Description</th>
                                <th class="text-right">Quantity</th>
                                <th class="text-right">UoM</th>
                                <th class="text-right">Unit Price</th>
                                <th class="text-right">Taxes</th>
                                <th class="text-right">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.order_line" t-as="line">
                                <tr t-if="line.display_type == 'line_section'">
                                    <td colspan="6" style="font-weight:bold; font-size:14px; border-top:1px solid #000;">
                                        <t t-esc="line.name"/>
                                    </td>
                                </tr>
                                <tr t-if="not line.display_type">
                                    <td><t t-esc="line.product_id.display_name or line.name"/></td>
                                    <td class="text-right"><t t-esc="line.product_uom_qty"/></td>
                                    <td class="text-right"><t t-esc="line.product_uom.name or ''"/></td>
                                    <td class="text-right"><span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    <td class="text-right"><t t-esc="', '.join([tax.display_name for tax in line.tax_id])"/></td>
                                    <td class="text-right"><span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>

                <!-- =============================
                     Letter Quotation Table
                     ============================= -->
                <t t-if="doc.quotation_type == 'letter'">
                    <table class="table table-sm" style="width:100%; font-size:12px;">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th class="text-right">Quantity</th>
                                <th class="text-right">Unit Price</th>
                                <th class="text-right">Taxes</th>
                                <th class="text-right">Tax excl</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.letter_line_ids" t-as="line">
                                <tr t-if="line.display_type == 'line_section'">
                                    <td colspan="5" style="font-weight:bold; font-size:14px; border-top:1px solid #000;">
                                        <t t-esc="line.name"/>
                                    </td>
                                </tr>
                                <tr t-if="not line.display_type">
                                    <td><t t-esc="line.product_id.display_name"/></td>
                                    <td class="text-right"><t t-esc="line.product_uom_qty"/></td>
                                    <td class="text-right"><t t-esc="line.price_unit"/></td>
                                    <td class="text-right"><t t-esc="', '.join([tax.display_name for tax in line.tax_id])"/></td>
                                    <td class="text-right"><t t-esc="line.price_subtotal"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>

                <!-- =============================
                     Signature Section
                     ============================= -->
                <t t-if="doc.quotation_type == 'quotation'">
                    <div style="margin-top: 60px; text-align: left;">
                        <p style="margin-bottom: 5px;"><strong>Yours sincerely,</strong></p>
                        <p style="margin: 0;"><t t-esc="doc.user_id.name or 'ERROR'"/></p>
                        <p style="margin: 0;"><t t-esc="doc.company_id.name or 'ERROR'"/></p>
                        <p style="margin: 0;">
                            <strong>Email:</strong>
                            <t t-esc="doc.user_id.email or '-'"/><br/>
                            <strong>Tel:</strong>
                            <t t-esc="doc.user_id.phone or doc.company_id.phone or '-'"/>
                        </p>
                    </div>
                </t>

            </div>
        </xpath>
    </template>
</odoo>
