<!-- server/odoo/custom_addons/sale_port_rates/report/sale_order_report.xml -->
<odoo>
    <template id="report_saleorder_port_rates" inherit_id="sale.report_saleorder_document">
        <!-- Hide the original customer address block from the informations row (first column) -->
        <xpath expr="//div[@id='informations']/div[1]" position="attributes">
            <attribute name="style">display:none;</attribute>
        </xpath>
        <!-- Insert the customer address block above Dear section, left-aligned -->
        <xpath expr="//div[contains(@class,'page')]" position="before">
            <div style="text-align:left; margin-bottom: 20px;">
                <div t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
            </div>
        </xpath>
        <xpath expr="//div[contains(@class,'page')]" position="replace">
            <div class="page">
                <!-- Letter Quotation Header -->
                <t t-if="doc.quotation_type == 'letter'">
                    <div style="margin-bottom: 30px;">
                        <p><strong>Dear </strong><t t-esc="doc.partner_id.name"/></p>
                        <p style="font-size:30px; font-weight:900; text-decoration:underline;">
                            <strong>Subject:</strong> <t t-esc="doc.subject"/>
                        </p>
                    </div>
                </t>
                <h2 style="text-align:center; margin-top:40px; margin-bottom:20px;">
                    <t t-if="doc.quotation_type == 'letter'">Letter Quotation</t>
                    <t t-elif="doc.quotation_type == 'port_rate'">Port Rates Quotation</t>
                    <t t-else="">Quotation</t>
                </h2>
                <!-- Date field only -->
                <div style="margin-top:20px; margin-bottom:20px;">
                    <p><strong>Date:</strong>
                        <span t-field="doc.date_order" t-options="{'format': 'dd/MM/yyyy HH:mm:ss'}"/>
                    </p>
                </div>

                <!-- Port Rates Table (only for port_rate) -->
                <t t-if="doc.quotation_type == 'port_rate'">
                    <table class="table table-sm table-bordered bg-light" style="border-collapse: collapse; width:100%; color:black; border: 1px solid #000;">
                        <thead>
                            <tr style="background-color:#f0f0f0;">
                                <th style="border:1px solid #000; padding:5px;">Port</th>
                                <th style="border:1px solid #000; padding:5px;">Validation</th>
                                <th style="border:1px solid #000; padding:5px;">Export Rate</th>
                                <th style="border:1px solid #000; padding:5px;">Inclusive</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.port_order_line_ids" t-as="l">
                                <td style="border:1px solid #000; padding:5px;"><span t-field="l.port"/></td>
                                <td style="border:1px solid #000; padding:5px;"><span t-field="l.validation"/></td>
                                <td style="border:1px solid #000; padding:5px; text-align:right;">
                                    <span t-field="l.export_rate"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                                <td style="border:1px solid #000; padding:5px;"><span t-field="l.inclusive"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>

                <!-- Standard Quotation Table -->
                <t t-if="doc.quotation_type == 'quotation'">
                    <table class="table table-sm table-bordered bg-light" style="border-collapse: collapse; width:100%; color:black; border: 1px solid #000;">
                        <thead>
                            <tr>
                                <th>Product / Description</th>
                                <th class="text-right">Quantity</th>
                                <th class="text-right">Unit of Measure</th>
                                <th class="text-right">Unit Price</th>
                                <th class="text-right">Taxes</th>
                                <th class="text-right">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.order_line" t-as="line">
                                <tr t-if="line.display_type == 'line_section'">
                                    <td colspan="6" style="font-weight:bold; font-size: 16px; border-top: 2px solid #000;">
                                        <t t-esc="line.name"/>
                                    </td>
                                </tr>
                                <tr t-if="not line.display_type">
                                    <td>
                                        <t t-esc="line.product_id.display_name or line.name"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="line.product_uom_qty"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="line.product_uom.name or ''"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="', '.join([tax.display_name for tax in line.tax_id])"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>

                <!-- Letter Quotation Table -->
                <t t-if="doc.quotation_type == 'letter'">
                    <table class="table table-sm table-bordered bg-light" style="border-collapse: collapse; width:100%; color:black; border: 1px solid #000;">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th class="text-right">Quantity</th>
                                <th class="text-right">Unit Price</th>
                                <th class="text-right">Taxes</th>
                                <th class="text-right">Tax excl</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.letter_line_ids" t-as="line">
                                <tr t-if="line.display_type == 'line_section'">
                                    <td colspan="5" style="font-weight:bold; font-size: 16px; border-top: 2px solid #000;">
                                        <t t-esc="line.name"/>
                                    </td>
                                </tr>
                                <tr t-if="not line.display_type">
                                    <td>
                                        <t t-esc="line.product_id.display_name"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="line.product_uom_qty"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="line.price_unit"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="', '.join([tax.display_name for tax in line.tax_id])"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="line.price_subtotal"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>
        </xpath>
    </template>
</odoo>
