<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_saleorder_document_inherit_mail_body" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@class='page']" position="before">
            <t t-if="doc.mail_body">
                <div style="margin-bottom: 20px;">
                    <div t-field="doc.mail_body"/>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
