<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_saleorder_document_inherit_mail_body" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[contains(@class, 'page')]" position="inside">
            <t t-if="doc.cleaned_mail_body" style="border: none !important;">
                <div style="margin: 0 0 20px 0; padding: 0; border: none !important; background: none !important; box-shadow: none !important;">
                    <t t-raw="doc.cleaned_mail_body"/>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
