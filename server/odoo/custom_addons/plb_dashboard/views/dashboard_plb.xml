<odoo>
    <record id="PLB_dashboard_action" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">PLB_dashboard_tag</field>
    </record>

    <record id="PLB_kpi_action" model="ir.actions.client">
        <field name="name">KPI</field>
        <field name="tag">PLB_kpi_tag</field>
    </record>

    <menuitem id="PLB_root_menu" name="PLB"/>
