    <menuitem id="PLB_kpi_menu" name="KPI" parent="PLB_root_menu" action="PLB_kpi_action" sequence="20"/>
    <menuitem id="PLB_config_menu" name="Config" parent="PLB_root_menu" sequence="30"/>
    <menuitem id="PLB_target_kpi_menu" name="Target KPI" parent="PLB_config_menu" action="action_employee_target_kpi" sequence="10"/>
</odoo>