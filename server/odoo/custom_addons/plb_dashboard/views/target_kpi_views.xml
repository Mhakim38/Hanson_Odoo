<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for Target KPI Settings -->
    <record id="view_target_kpi_settings_tree" model="ir.ui.view">
        <field name="name">target.kpi.settings.tree</field>
        <field name="model">target.kpi.settings</field>
        <field name="arch" type="xml">
            <tree string="Target KPI Settings">
                <field name="name"/>
                <field name="yearly_target" string="Company Yearly Target"/>
            </tree>
        </field>
    </record>

    <!-- Form View for Target KPI Settings -->
    <record id="view_target_kpi_settings_form" model="ir.ui.view">
        <field name="name">target.kpi.settings.form</field>
        <field name="model">target.kpi.settings</field>
        <field name="arch" type="xml">
            <form string="Target KPI Settings">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="year" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" invisible="1"/>
                            <field name="yearly_target" string="Company Yearly Target"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Employee Personal Targets">
                            <field name="employee_target_ids" widget="one2many" mode="tree">
                                <tree editable="bottom" create="false" delete="false">
                                    <field name="employee_id" string="Employee" readonly="1" width="50%"/>
                                    <field name="personal_target" string="Personal Target" width="50%"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Target KPI -->
    <record id="action_employee_target_kpi" model="ir.actions.act_window">
        <field name="name">Target KPI</field>
        <field name="res_model">target.kpi.settings</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_year': context.get('current_year', 2025)}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create yearly targets for the company and employees
            </p>
            <p>
                Click the Create button to set targets for a new year.
            </p>
        </field>
    </record>
</odoo>

