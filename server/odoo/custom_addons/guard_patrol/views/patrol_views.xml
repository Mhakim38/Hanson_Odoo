<odoo>
  <record id="view_patrol_route_tree" model="ir.ui.view">
    <field name="name">patrol.route.tree</field>
    <field name="model">patrol.route</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="property_id"/>
        <field name="active"/>
      </tree>
    </field>
  </record>

  <record id="view_patrol_route_form" model="ir.ui.view">
    <field name="name">patrol.route.form</field>
    <field name="model">patrol.route</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="property_id"/>
            <field name="active"/>
            <field name="description"/>
          </group>
          <notebook>
            <page string="Checkpoints">
              <field name="checkpoint_ids">
                <tree editable="bottom">
                  <field name="sequence"/>
                  <field name="name"/>
                  <field name="qr_code"/>
                  <field name="nfc_uid"/>
                  <field name="geo_lat"/>
                  <field name="geo_lng"/>
                  <field name="sla_minutes"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_patrol_tour_tree" model="ir.ui.view">
    <field name="name">patrol.tour.tree</field>
    <field name="model">patrol.tour</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="route_id"/>
        <field name="assigned_user_id"/>
        <field name="start_planned"/>
        <field name="state"/>
      </tree>
    </field>
  </record>

  <record id="view_patrol_tour_form" model="ir.ui.view">
    <field name="name">patrol.tour.form</field>
    <field name="model">patrol.tour</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="property_id"/>
            <field name="route_id"/>
            <field name="assigned_user_id"/>
            <field name="start_planned"/>
            <field name="end_planned"/>
            <field name="start_actual"/>
            <field name="end_actual"/>
            <field name="state"/>
          </group>
          <notebook>
            <page string="Logs">
              <field name="log_ids">
                <tree editable="bottom">
                  <field name="checkpoint_id"/>
                  <field name="scan_time"/>
                  <field name="on_time"/>
                  <field name="note"/>
                </tree>
              </field>
            </page>
            <page string="Incidents">
              <field name="incident_ids">
                <tree editable="bottom">
                  <field name="title"/>
                  <field name="severity"/>
                  <field name="reported_at"/>
                  <field name="photo_ids" widget="many2many_binary" filename="name"/>/>
                  <field name="state"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
