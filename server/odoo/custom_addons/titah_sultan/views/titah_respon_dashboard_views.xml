<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_titah_respon_dashboard_kanban" model="ir.ui.view">
        <field name="name">titah.respon.dashboard.kanban</field>
        <field name="model">titah.respon.dashboard</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record" style="padding: 10px; display: flex; gap: 20px;">
                            <div style="background-color: #d4edda; padding: 10px; border-radius: 6px;">
                                <strong>✔ Telah Dilaksanakan:</strong>
                                <span><t t-esc="record.total_hijau.value"/></span>
                            </div>
                            <div style="background-color: #fff3cd; padding: 10px; border-radius: 6px;">
                                <strong>⏳ Dalam Tindakan:</strong>
                                <span><t t-esc="record.total_kuning.value"/></span>
                            </div>
                            <div style="background-color: #f8d7da; padding: 10px; border-radius: 6px;">
                                <strong>❌ Tidak Dilaksanakan:</strong>
                                <span><t t-esc="record.total_merah.value"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_titah_respon_dashboard" model="ir.actions.act_window">
        <field name="name">Statistik Pelaksanaan</field>
        <field name="res_model">titah.respon.dashboard</field>
        <field name="view_mode">kanban</field>
        <field name="target">inline</field>
    </record>
</odoo>
