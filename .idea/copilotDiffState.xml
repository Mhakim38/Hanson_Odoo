              <option name="originalContent" value="&lt;odoo&gt;&#10;  &lt;!-- ✅ QR Valid Page --&gt;&#10;  &lt;template id=&quot;qr_verify_template&quot; name=&quot;Visitor QR Verification Page&quot;&gt;&#10;    &lt;t t-call=&quot;website.layout&quot;&gt;&#10;      &lt;div class=&quot;container my-5&quot;&gt;&#10;        &lt;div class=&quot;card shadow-lg border-0&quot;&gt;&#10;          &lt;div class=&quot;card-header bg-primary text-white text-center&quot;&gt;&#10;            &lt;h2&gt;Visitor Verification&lt;/h2&gt;&#10;          &lt;/div&gt;&#10;          &lt;div class=&quot;card-body&quot;&gt;&#10;            &lt;div class=&quot;row&quot;&gt;&#10;              &lt;div class=&quot;col-md-6&quot;&gt;&#10;                &lt;h5&gt;Visitor Details&lt;/h5&gt;&#10;                &lt;p&gt;&lt;strong&gt;Name:&lt;/strong&gt; &lt;t t-esc=&quot;visit.visitor_id.name&quot;/&gt;&lt;/p&gt;&#10;                &lt;p&gt;&lt;strong&gt;Purpose:&lt;/strong&gt; &lt;t t-esc=&quot;visit.purpose or '-'&quot;/&gt;&lt;/p&gt;&#10;                &lt;p&gt;&lt;strong&gt;Host:&lt;/strong&gt; &lt;t t-esc=&quot;visit.host_id.name&quot;/&gt;&lt;/p&gt;&#10;                &lt;p&gt;&lt;strong&gt;Unit:&lt;/strong&gt; &lt;t t-esc=&quot;visit.unit_id.display_name&quot;/&gt;&lt;/p&gt;&#10;              &lt;/div&gt;&#10;              &lt;div class=&quot;col-md-6 text-center&quot;&gt;&#10;                &lt;h5&gt;Badge / QR Info&lt;/h5&gt;&#10;                &lt;p&gt;&lt;strong&gt;Badge No:&lt;/strong&gt; &lt;t t-esc=&quot;visit.badge_no or '-'&quot;/&gt;&lt;/p&gt;&#10;                &lt;p&gt;&lt;strong&gt;QR Token:&lt;/strong&gt; &lt;t t-esc=&quot;visit.qr_token or '-'&quot;/&gt;&lt;/p&gt;&#10;                &lt;img t-if=&quot;visit.qr_image&quot; t-att-src=&quot;'data:image/png;base64,%s' % (visit.qr_image)&quot; class=&quot;img-fluid rounded shadow mt-3&quot; style=&quot;max-width:200px;&quot;/&gt;&#10;              &lt;/div&gt;&#10;            &lt;/div&gt;&#10;            &lt;hr/&gt;&#10;            &lt;div class=&quot;text-center&quot;&gt;&#10;              &lt;t t-set=&quot;state_label&quot; t-value=&quot;visit._fields['state'].convert_to_export(visit.state, visit)&quot;/&gt;&#10;              &lt;span t-attf-class=&quot;badge&#10;                #{'bg-secondary' if visit.state == 'draft' else ''}&#10;                #{'bg-info' if visit.state == 'scheduled' else ''}&#10;                #{'bg-success' if visit.state == 'check_in' else ''}&#10;                #{'bg-warning text-dark' if visit.state == 'check_out' else ''}&#10;                #{'bg-danger' if visit.state == 'cancel' else ''}&quot;&gt;&#10;                &lt;t t-esc=&quot;state_label&quot;/&gt;&#10;              &lt;/span&gt;&#10;              &lt;p class=&quot;mt-3 text-muted&quot;&gt;Valid until &lt;t t-esc=&quot;visit.qr_expiry or 'N/A'&quot;/&gt;&lt;/p&gt;&#10;            &lt;/div&gt;&#10;          &lt;/div&gt;&#10;        &lt;/div&gt;&#10;      &lt;/div&gt;&#10;    &lt;/t&gt;&#10;  &lt;/template&gt;&#10;&#10;  &lt;!-- ❌ Invalid QR --&gt;&#10;  &lt;template id=&quot;qr_invalid_template&quot; name=&quot;Invalid QR Page&quot;&gt;&#10;    &lt;t t-call=&quot;website.layout&quot;&gt;&#10;      &lt;div class=&quot;container my-5 text-center&quot;&gt;&#10;        &lt;div class=&quot;alert alert-danger shadow&quot;&gt;&#10;          &lt;h4 class=&quot;alert-heading&quot;&gt;Invalid or Expired QR Code&lt;/h4&gt;&#10;          &lt;p&gt;Please contact the resident or management for assistance.&lt;/p&gt;&#10;        &lt;/div&gt;&#10;      &lt;/div&gt;&#10;    &lt;/t&gt;&#10;  &lt;/template&gt;&#10;&lt;/odoo&gt;&#10;" />
              <option name="updatedContent" value="&lt;odoo&gt;&#10;  &lt;!-- ✅ QR Valid Page --&gt;&#10;  &lt;template id=&quot;qr_verify_template&quot; name=&quot;Visitor QR Verification Page&quot;&gt;&#10;    &lt;t t-call=&quot;website.layout&quot;&gt;&#10;      &lt;div class=&quot;container my-5&quot;&gt;&#10;        &lt;div class=&quot;card shadow-lg border-0&quot;&gt;&#10;          &lt;div class=&quot;card-header bg-primary text-white text-center&quot;&gt;&#10;            &lt;h2&gt;Visitor Verification&lt;/h2&gt;&#10;          &lt;/div&gt;&#10;          &lt;div class=&quot;card-body&quot;&gt;&#10;            &lt;div class=&quot;row&quot;&gt;&#10;              &lt;div class=&quot;col-md-6&quot;&gt;&#10;                &lt;h5&gt;Visitor Details&lt;/h5&gt;&#10;                &lt;p&gt;&lt;strong&gt;Name:&lt;/strong&gt; &lt;t t-esc=&quot;visit.visitor_id.name&quot;/&gt;&lt;/p&gt;&#10;                &lt;p&gt;&lt;strong&gt;Purpose:&lt;/strong&gt; &lt;t t-esc=&quot;visit.purpose or '-'&quot;/&gt;&lt;/p&gt;&#10;                &lt;p&gt;&lt;strong&gt;Host:&lt;/strong&gt; &lt;t t-esc=&quot;visit.host_id.name&quot;/&gt;&lt;/p&gt;&#10;                &lt;p&gt;&lt;strong&gt;Unit:&lt;/strong&gt; &lt;t t-esc=&quot;visit.unit_id.display_name&quot;/&gt;&lt;/p&gt;&#10;              &lt;/div&gt;&#10;              &lt;div class=&quot;col-md-6 text-center&quot;&gt;&#10;                &lt;h5&gt;Badge / QR Info&lt;/h5&gt;&#10;                &lt;p&gt;&lt;strong&gt;Badge No:&lt;/strong&gt; &lt;t t-esc=&quot;visit.badge_no or '-'&quot;/&gt;&lt;/p&gt;&#10;                &lt;p&gt;&lt;strong&gt;QR Token:&lt;/strong&gt; &lt;t t-esc=&quot;visit.qr_token or '-'&quot;/&gt;&lt;/p&gt;&#10;                &lt;img t-if=&quot;visit.qr_image&quot; t-att-src=&quot;'data:image/png;base64,%s' % (visit.qr_image)&quot; class=&quot;img-fluid rounded shadow mt-3&quot; style=&quot;max-width:200px;&quot;/&gt;&#10;              &lt;/div&gt;&#10;            &lt;/div&gt;&#10;            &lt;hr/&gt;&#10;            &lt;div class=&quot;text-center&quot;&gt;&#10;              &lt;t t-set=&quot;state_label&quot; t-value=&quot;visit._fields['state'].convert_to_export(visit.state, visit)&quot;/&gt;&#10;              &lt;span t-attf-class=&quot;badge&#10;                #{'bg-secondary' if visit.state == 'draft' else ''}&#10;                #{'bg-info' if visit.state == 'scheduled' else ''}&#10;                #{'bg-success' if visit.state == 'check_in' else ''}&#10;                #{'bg-warning text-dark' if visit.state == 'check_out' else ''}&#10;                #{'bg-danger' if visit.state == 'cancel' else ''}&quot;&gt;&#10;                &lt;t t-esc=&quot;state_label&quot;/&gt;&#10;              &lt;/span&gt;&#10;              &lt;p class=&quot;mt-3 text-muted&quot;&gt;Valid until &lt;t t-esc=&quot;visit.qr_expiry or 'N/A'&quot;/&gt;&lt;/p&gt;&#10;            &lt;/div&gt;&#10;          &lt;/div&gt;&#10;        &lt;/div&gt;&#10;      &lt;/div&gt;&#10;    &lt;/t&gt;&#10;  &lt;/template&gt;&#10;&#10;  &lt;!-- ❌ Invalid QR --&gt;&#10;  &lt;template id=&quot;qr_invalid_template&quot; name=&quot;Invalid QR Page&quot;&gt;&#10;    &lt;t t-call=&quot;website.layout&quot;&gt;&#10;      &lt;div class=&quot;container my-5 text-center&quot;&gt;&#10;        &lt;div class=&quot;alert alert-danger shadow&quot;&gt;&#10;          &lt;h4 class=&quot;alert-heading&quot;&gt;Invalid or Expired QR Code&lt;/h4&gt;&#10;          &lt;p&gt;Please contact the resident or management for assistance.&lt;/p&gt;&#10;        &lt;/div&gt;&#10;      &lt;/div&gt;&#10;    &lt;/t&gt;&#10;  &lt;/template&gt;&#10;&#10;  &lt;!-- Visitor info page (when a visitor QR is scanned) --&gt;&#10;  &lt;template id=&quot;visitor_info_template&quot; name=&quot;Visitor Info Page&quot;&gt;&#10;    &lt;t t-call=&quot;website.layout&quot;&gt;&#10;      &lt;div class=&quot;container my-5&quot;&gt;&#10;        &lt;div class=&quot;card shadow border-0&quot;&gt;&#10;          &lt;div class=&quot;card-header bg-primary text-white text-center&quot;&gt;&#10;            &lt;h3&gt;Visitor Details&lt;/h3&gt;&#10;          &lt;/div&gt;&#10;          &lt;div class=&quot;card-body&quot;&gt;&#10;            &lt;div class=&quot;row&quot;&gt;&#10;              &lt;div class=&quot;col-md-6&quot;&gt;&#10;                &lt;p&gt;&lt;strong&gt;Name:&lt;/strong&gt; &lt;t t-esc=&quot;visitor.name&quot;/&gt;&lt;/p&gt;&#10;                &lt;p&gt;&lt;strong&gt;Phone:&lt;/strong&gt; &lt;t t-esc=&quot;visitor.phone or '-'&quot;/&gt;&lt;/p&gt;&#10;                &lt;p&gt;&lt;strong&gt;ID Type:&lt;/strong&gt; &lt;t t-esc=&quot;visitor.id_type or '-'&quot;/&gt;&lt;/p&gt;&#10;                &lt;p&gt;&lt;strong&gt;ID Number:&lt;/strong&gt; &lt;t t-esc=&quot;visitor.id_number or '-'&quot;/&gt;&lt;/p&gt;&#10;                &lt;p&gt;&lt;strong&gt;Notes:&lt;/strong&gt; &lt;t t-esc=&quot;visitor.notes or '-'&quot;/&gt;&lt;/p&gt;&#10;              &lt;/div&gt;&#10;              &lt;div class=&quot;col-md-6 text-center&quot;&gt;&#10;                &lt;h5&gt;QR&lt;/h5&gt;&#10;                &lt;img t-if=&quot;visitor.qr_image&quot; t-att-src=&quot;'data:image/png;base64,%s' % (visitor.qr_image)&quot; class=&quot;img-fluid&quot; style=&quot;max-width:240px;&quot;/&gt;&#10;                &lt;p class=&quot;mt-2 text-muted&quot;&gt;Token: &lt;t t-esc=&quot;visitor.qr_token or '-'&quot;/&gt;&lt;/p&gt;&#10;              &lt;/div&gt;&#10;            &lt;/div&gt;&#10;          &lt;/div&gt;&#10;        &lt;/div&gt;&#10;      &lt;/div&gt;&#10;    &lt;/t&gt;&#10;  &lt;/template&gt;&#10;&#10;  &lt;!-- Visitor scanner page: opens camera and scans QR codes --&gt;&#10;  &lt;template id=&quot;visitor_scan_template&quot; name=&quot;Visitor QR Scanner&quot;&gt;&#10;    &lt;t t-call=&quot;website.layout&quot;&gt;&#10;      &lt;div class=&quot;container my-5&quot;&gt;&#10;        &lt;div class=&quot;card shadow border-0&quot;&gt;&#10;          &lt;div class=&quot;card-header bg-primary text-white text-center&quot;&gt;&#10;            &lt;h3&gt;Scan Visitor QR&lt;/h3&gt;&#10;          &lt;/div&gt;&#10;          &lt;div class=&quot;card-body text-center&quot;&gt;&#10;            &lt;p&gt;Allow camera access when prompted. The scanner will detect the QR and redirect to the visitor page.&lt;/p&gt;&#10;&#10;            &lt;div id=&quot;qr-reader&quot; style=&quot;width:100%; max-width:500px; margin:0 auto;&quot;&gt;&lt;/div&gt;&#10;            &lt;div id=&quot;qr-result&quot; class=&quot;mt-3&quot;&gt;&lt;/div&gt;&#10;&#10;            &lt;div class=&quot;mt-3&quot;&gt;&#10;              &lt;button id=&quot;btn-stop&quot; class=&quot;btn btn-danger d-none&quot;&gt;Stop Scanner&lt;/button&gt;&#10;              &lt;a href=&quot;/&quot; class=&quot;btn btn-secondary&quot;&gt;Close&lt;/a&gt;&#10;            &lt;/div&gt;&#10;&#10;            &lt;!-- Load html5-qrcode from CDN --&gt;&#10;            &lt;script src=&quot;https://unpkg.com/html5-qrcode@2.3.7&quot;&gt;&lt;/script&gt;&#10;            &lt;script type=&quot;text/javascript&quot;&gt;&lt;![CDATA[&#10;              (function () {&#10;                var resultEl = document.getElementById('qr-result');&#10;                var btnStop = document.getElementById('btn-stop');&#10;                var lastResult = null;&#10;&#10;                function handleScan(decodedText, decodedResult) {&#10;                  if (!decodedText || decodedText === lastResult) {&#10;                    return;&#10;                  }&#10;                  lastResult = decodedText;&#10;                  resultEl.innerHTML = '&lt;div class=&quot;alert alert-success&quot;&gt;Scanned: ' + decodedText + '&lt;/div&gt;';&#10;&#10;                  // If the scanned text is a full URL, navigate to it.&#10;                  if (/^https?:\/\//i.test(decodedText) || decodedText.indexOf('/') === 0) {&#10;                    window.location.href = decodedText;&#10;                    return;&#10;                  }&#10;&#10;                  // Otherwise assume it's a token; try redirect to visitor/verify first, then visitor/info&#10;                  var tryUrl = '/visitor/verify/' + encodeURIComponent(decodedText);&#10;                  window.location.href = tryUrl;&#10;                }&#10;&#10;                var html5QrcodeScanner = new Html5Qrcode(/* element id */ &quot;qr-reader&quot;);&#10;&#10;                Html5Qrcode.getCameras().then(function(cameras) {&#10;                  if (cameras &amp;&amp; cameras.length) {&#10;                    var cameraId = cameras[0].id;&#10;                    html5QrcodeScanner.start(&#10;                      cameraId,&#10;                      { fps: 10, qrbox: 250 },&#10;                      handleScan&#10;                    ).then(function() {&#10;                      btnStop.classList.remove('d-none');&#10;                    }).catch(function(err){&#10;                      resultEl.innerHTML = '&lt;div class=&quot;alert alert-danger&quot;&gt;Unable to start camera: ' + err + '&lt;/div&gt;';&#10;                    });&#10;                  } else {&#10;                    resultEl.innerHTML = '&lt;div class=&quot;alert alert-warning&quot;&gt;No camera found&lt;/div&gt;';&#10;                  }&#10;                }).catch(function(err){&#10;                  resultEl.innerHTML = '&lt;div class=&quot;alert alert-danger&quot;&gt;Error accessing cameras: ' + err + '&lt;/div&gt;';&#10;                });&#10;&#10;                btnStop.addEventListener('click', function(){&#10;                  html5QrcodeScanner.stop().then(function() {&#10;                    btnStop.classList.add('d-none');&#10;                    resultEl.innerHTML = '&lt;div class=&quot;alert alert-info&quot;&gt;Scanner stopped.&lt;/div&gt;';&#10;                  }).catch(function(err){&#10;                    resultEl.innerHTML = '&lt;div class=&quot;alert alert-danger&quot;&gt;Failed to stop scanner: ' + err + '&lt;/div&gt;';&#10;                  });&#10;                });&#10;              })();&#10;            ]]&gt;&lt;/script&gt;&#10;&#10;          &lt;/div&gt;&#10;        &lt;/div&gt;&#10;      &lt;/div&gt;&#10;    &lt;/t&gt;&#10;  &lt;/template&gt;&#10;&#10;&lt;/odoo&gt;" />
