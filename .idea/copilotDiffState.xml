ption t-att-value=&quot;u.id&quot; t-esc=&quot;u.display_name&quot;/&gt;&#10;              &lt;/t&gt;&#10;            &lt;/select&gt;&#10;          &lt;/div&gt;&#10;          &lt;div class=&quot;col-md-3 col-6&quot;&gt;&#10;            &lt;button class=&quot;btn btn-primary w-100&quot; type=&quot;submit&quot;&gt;Filter&lt;/button&gt;&#10;          &lt;/div&gt;&#10;        &lt;/form&gt;&#10;&#10;        &lt;div class=&quot;text-end mb-3&quot;&gt;&#10;          &lt;a t-att-href=&quot;'/guard/visitors/pdf?date=%s&amp;amp;status=%s&amp;amp;unit_id=%s' % (today.strftime('%Y-%m-%d'), request.params.get('status') or '', request.params.get('unit_id') or '')&quot;&#10;             class=&quot;btn btn-outline-danger&quot;&gt;Export PDF&lt;/a&gt;&#10;        &lt;/div&gt;&#10;&#10;        &lt;!-- Visitor Table (Desktop) --&gt;&#10;        &lt;div class=&quot;table-responsive d-none d-md-block&quot;&gt;&#10;          &lt;table class=&quot;table table-striped&quot;&gt;&#10;            &lt;thead&gt;&#10;              &lt;tr&gt;&#10;                &lt;th&gt;Visitor&lt;/th&gt;&#10;                &lt;th&gt;Host&lt;/th&gt;&#10;                &lt;th&gt;Unit&lt;/th&gt;&#10;                &lt;th&gt;Purpose&lt;/th&gt;&#10;                &lt;th&gt;Schedule&lt;/th&gt;&#10;                &lt;th&gt;Status&lt;/th&gt;&#10;                &lt;th&gt;Action&lt;/th&gt;&#10;              &lt;/tr&gt;&#10;            &lt;/thead&gt;&#10;            &lt;tbody&gt;&#10;              &lt;t t-foreach=&quot;visits&quot; t-as=&quot;v&quot;&gt;&#10;                &lt;tr&gt;&#10;                  &lt;td t-esc=&quot;v.visitor_id.name or '-'&quot;/&gt;&#10;                  &lt;td t-esc=&quot;v.host_id.name or '-'&quot;/&gt;&#10;                  &lt;td t-esc=&quot;v.unit_id.display_name or '-'&quot;/&gt;&#10;                  &lt;td t-esc=&quot;v.purpose or '-'&quot;/&gt;&#10;                  &lt;td&gt;&lt;t t-esc=&quot;v.schedule_from&quot;/&gt; → &lt;t t-esc=&quot;v.schedule_to&quot;/&gt;&lt;/td&gt;&#10;&#10;                  &lt;!-- Status td --&gt;&#10;                  &lt;td&gt;&#10;                    &lt;t t-set=&quot;state_label&quot; t-value=&quot;dict(v._fields['state'].selection).get(v.state, v.state or '-')&quot;/&gt;&#10;                    &lt;t t-if=&quot;v.state in ['draft', 'scheduled']&quot;&gt;&#10;                      &lt;span class=&quot;badge btn btn-dark&quot; t-esc=&quot;state_label&quot;/&gt;&#10;                    &lt;/t&gt;&#10;                    &lt;t t-elif=&quot;v.state == 'check_in'&quot;&gt;&#10;                      &lt;span class=&quot;badge bg-success&quot; t-esc=&quot;state_label&quot;/&gt;&#10;                    &lt;/t&gt;&#10;                    &lt;t t-elif=&quot;v.state == 'check_out'&quot;&gt;&#10;                      &lt;span class=&quot;badge bg-danger&quot; t-esc=&quot;state_label&quot;/&gt;&#10;                    &lt;/t&gt;&#10;                    &lt;t t-else=&quot;&quot;&gt;&#10;                      &lt;span class=&quot;badge bg-light text-dark&quot; t-esc=&quot;state_label&quot;/&gt;&#10;                    &lt;/t&gt;&#10;                  &lt;/td&gt;&#10;&#10;                    &lt;!-- Action td --&gt;&#10;                  &lt;td&gt;&#10;                    &lt;t t-if=&quot;v.state == 'check_out'&quot;&gt;&#10;                      &lt;span class=&quot;text-muted small&quot;&gt;No Action&lt;/span&gt;&#10;                    &lt;/t&gt;&#10;                    &lt;t t-else=&quot;&quot;&gt;&#10;                      &lt;a t-att-href=&quot;'/guard/visitors/checkin/%d' % v.id if v.state != 'check_in' else False&quot;&#10;                         t-att-class=&quot;'btn btn-success btn-sm btn-checkin' + (' disabled' if v.state == 'check_in' else '')&quot;&#10;                         t-att-title=&quot;'Check in'&quot;&#10;                         t-att-aria-disabled=&quot;'true' if v.state == 'check_in' else False&quot;&gt;&#10;                        &lt;span aria-hidden=&quot;true&quot;&gt;✓&lt;/span&gt;&#10;                        &lt;span class=&quot;visually-hidden&quot;&gt;Check-in&lt;/span&gt;&#10;                      &lt;/a&gt;&#10;                      &lt;a t-att-href=&quot;'/guard/visitors/checkout/%d' % v.id&quot;&#10;                         class=&quot;btn btn-danger btn-sm btn-checkout ms-1&quot;&#10;                         t-att-title=&quot;'Check out'&quot;&gt;&#10;                        &lt;span aria-hidden=&quot;true&quot;&gt;⤴&lt;/span&gt;&#10;                        &lt;span class=&quot;visually-hidden&quot;&gt;Check-out&lt;/span&gt;&#10;                      &lt;/a&gt;&#10;                    &lt;/t&gt;&#10;                  &lt;/td&gt;&#10;                &lt;/tr&gt;&#10;              &lt;/t&gt;&#10;            &lt;/tbody&gt;&#10;          &lt;/table&gt;&#10;        &lt;/div&gt;&#10;&#10;        &lt;!-- Visitor Cards (Mobile) --&gt;&#10;        &lt;div class=&quot;d-md-none&quot;&gt;&#10;          &lt;t t-foreach=&quot;visits&quot; t-as=&quot;v&quot;&gt;&#10;            &lt;div class=&quot;card mb-2 shadow-sm&quot;&gt;&#10;              &lt;div class=&quot;card-body&quot;&gt;&#10;                &lt;h5 class=&quot;card-title&quot;&gt;&lt;t t-esc=&quot;v.visitor_id.name or '-'&quot;/&gt;&lt;/h5&gt;&#10;                &lt;p class=&quot;mb-1&quot;&gt;&lt;strong&gt;Host:&lt;/strong&gt; &lt;t t-esc=&quot;v.host_id.name or '-'&quot;/&gt;&lt;/p&gt;&#10;                &lt;p class=&quot;mb-1&quot;&gt;&lt;strong&gt;Unit:&lt;/strong&gt; &lt;t t-esc=&quot;v.unit_id.display_name or '-'&quot;/&gt;&lt;/p&gt;&#10;                &lt;p class=&quot;mb-1&quot;&gt;&lt;strong&gt;Purpose:&lt;/strong&gt; &lt;t t-esc=&quot;v.purpose or '-'&quot;/&gt;&lt;/p&gt;&#10;                &lt;p class=&quot;mb-1&quot;&gt;&lt;strong&gt;Schedule:&lt;/strong&gt; &lt;t t-esc=&quot;v.schedule_from&quot;/&gt; → &lt;t t-esc=&quot;v.schedule_to&quot;/&gt;&lt;/p&gt;&#10;&#10;                &lt;!-- Mobile status: badges --&gt;&#10;                &lt;p&gt;&lt;strong&gt;Status:&lt;/strong&gt;&#10;                  &lt;t t-set=&quot;m_state_label&quot; t-value=&quot;dict(v._fields['state'].selection).get(v.state, v.state or '-')&quot;/&gt;&#10;                  &lt;t t-if=&quot;v.state in ['draft', 'scheduled']&quot;&gt;&#10;                    &lt;span class=&quot;badge btn btn-dark&quot; t-esc=&quot;m_state_label&quot;/&gt;&#10;                  &lt;/t&gt;&#10;                  &lt;t t-elif=&quot;v.state == 'check_in'&quot;&gt;&#10;                    &lt;span class=&quot;badge bg-success&quot; t-esc=&quot;m_state_label&quot;/&gt;&#10;                  &lt;/t&gt;&#10;                  &lt;t t-elif=&quot;v.state == 'check_out'&quot;&gt;&#10;                    &lt;span class=&quot;badge bg-danger&quot; t-esc=&quot;m_state_label&quot;/&gt;&#10;                  &lt;/t&gt;&#10;                  &lt;t t-else=&quot;&quot;&gt;&#10;                    &lt;span class=&quot;badge bg-light text-dark&quot; t-esc=&quot;m_state_label&quot;/&gt;&#10;                  &lt;/t&gt;&#10;                &lt;/p&gt;&#10;&#10;                &lt;!-- Mobile actions: both buttons visible (full width) OR No Action --&gt;&#10;                &lt;t t-if=&quot;v.state == 'check_out'&quot;&gt;&#10;                  &lt;div class=&quot;text-muted small&quot;&gt;No Action&lt;/div&gt;&#10;                &lt;/t&gt;&#10;                &lt;t t-else=&quot;&quot;&gt;&#10;                  &lt;div class=&quot;d-flex gap-2&quot;&gt;&#10;                    &lt;a t-att-href=&quot;'/guard/visitors/checkin/%d' % v.id if v.state != 'check_in' else False&quot;&#10;                       t-att-class=&quot;'btn btn-success btn-sm btn-checkin flex-fill' + (' disabled' if v.state == 'check_in' else '')&quot;&#10;                       t-att-title=&quot;'Check in'&quot;&#10;                       t-att-aria-disabled=&quot;'true' if v.state == 'check_in' else False&quot;&gt;&#10;                      &lt;span aria-hidden=&quot;true&quot;&gt;✓&lt;/span&gt;&#10;                      &lt;span class=&quot;visually-hidden&quot;&gt;Check-in&lt;/span&gt;&#10;                    &lt;/a&gt;&#10;                    &lt;a t-att-href=&quot;'/guard/visitors/checkout/%d' % v.id&quot; class=&quot;btn btn-danger btn-sm btn-checkout flex-fill&quot; t-att-title=&quot;'Check out'&quot;&gt;&#10;                      &lt;span aria-hidden=&quot;true&quot;&gt;⤴&lt;/span&gt;&#10;                      &lt;span class=&quot;visually-hidden&quot;&gt;Check-out&lt;/span&gt;&#10;                    &lt;/a&gt;&#10;                  &lt;/div&gt;&#10;                &lt;/t&gt;&#10;&#10;              &lt;/div&gt;&#10;            &lt;/div&gt;&#10;          &lt;/t&gt;&#10;        &lt;/div&gt;&#10;      &lt;/div&gt;&#10;&#10;      &lt;!-- ✅ AJAX Logic --&gt;&#10;      &lt;script type=&quot;text/javascript&quot;&gt;&lt;![CDATA[&#10;          document.addEventListener('DOMContentLoaded', function() {&#10;&#10;            async function handleClick(e) {&#10;              e.preventDefault();&#10;              const btn = e.currentTarget;&#10;              // Ignore clicks on disabled-style anchors or anchors without href&#10;              if (btn.classList.contains('disabled') || !btn.getAttribute('href')) {&#10;                return;&#10;              }&#10;              const url = btn.getAttribute('href');&#10;              const card = btn.closest('.card, tr');&#10;&#10;              btn.classList.add('disabled');&#10;              btn.setAttribute('aria-disabled', 'true');&#10;              const originalHTML = btn.innerHTML;&#10;              btn.innerHTML = '&lt;span aria-hidden=&quot;true&quot;&gt;...&lt;/span&gt;';&#10;&#10;              try {&#10;                const response = await fetch(url, { method: 'GET' });&#10;                const result = await response.json();&#10;&#10;                if (!result.success) {&#10;                  alert(result.message || 'Error processing request');&#10;                  btn.classList.remove('disabled');&#10;                  btn.removeAttribute(