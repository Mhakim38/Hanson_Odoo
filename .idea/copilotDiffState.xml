            <PendingDiffInfo>
              <option name="filePath" value="$PROJECT_DIR$/server/odoo/custom_addons/PLB_input/views/crm_lead_views.xml" />
              <option name="originalContent" value="&lt;odoo&gt;&#10;    &lt;!-- New action to open the scheduling wizard as a modal (moved early so views can reference it) --&gt;&#10;    &lt;record id=&quot;action_schedule_activity_plb&quot; model=&quot;ir.actions.act_window&quot;&gt;&#10;        &lt;field name=&quot;name&quot;&gt;Schedule Activity&lt;/field&gt;&#10;        &lt;field name=&quot;res_model&quot;&gt;mail.activity.schedule&lt;/field&gt;&#10;        &lt;field name=&quot;view_mode&quot;&gt;form&lt;/field&gt;&#10;        &lt;field name=&quot;target&quot;&gt;new&lt;/field&gt;&#10;        &lt;field name=&quot;context&quot;&gt;{'default_res_model': 'crm.lead', 'default_res_id': active_id}&lt;/field&gt;&#10;    &lt;/record&gt;&#10;&#10;    &lt;!-- Custom Form View --&gt;&#10;    &lt;record id=&quot;view_crm_lead_form_custom&quot; model=&quot;ir.ui.view&quot;&gt;&#10;        &lt;field name=&quot;name&quot;&gt;crm.lead.form.custom&lt;/field&gt;&#10;        &lt;field name=&quot;model&quot;&gt;crm.lead&lt;/field&gt;&#10;        &lt;field name=&quot;inherit_id&quot; ref=&quot;crm.crm_lead_view_form&quot;/&gt;&#10;        &lt;field name=&quot;arch&quot; type=&quot;xml&quot;&gt;&#10;&#10;            &lt;!-- Add Decline button to the form header --&gt;&#10;            &lt;xpath expr=&quot;//form/header&quot; position=&quot;inside&quot;&gt;&#10;                    &lt;!-- ensure the computed flag is available to header modifiers --&gt;&#10;                &lt;field name=&quot;is_decline_stage&quot; invisible=&quot;1&quot;/&gt;&#10;                &lt;button name=&quot;action_decline&quot; string=&quot;Decline&quot; type=&quot;object&quot; class=&quot;btn-danger&quot; groups=&quot;base.group_system&quot;/&gt;&#10;            &lt;/xpath&gt;&#10;&#10;            &lt;!-- Hide core Won button when stage is Decline --&gt;&#10;            &lt;xpath expr=&quot;//form/header/button[@name='action_set_won_rainbowman']&quot; position=&quot;attributes&quot; optional=&quot;true&quot;&gt;&#10;                &lt;attribute name=&quot;modifiers&quot;&gt;{&quot;invisible&quot;: [[&quot;is_decline_stage&quot;,&quot;=&quot;, true]]}&lt;/attribute&gt;&#10;                &lt;attribute name=&quot;invisible&quot;&gt;is_decline_stage&lt;/attribute&gt;&#10;            &lt;/xpath&gt;&#10;&#10;            &lt;!-- Hide core Lost buttons when stage is Decline --&gt;&#10;            &lt;xpath expr=&quot;//form/header/button[@name='%(crm.crm_lead_lost_action)d']&quot; position=&quot;attributes&quot; optional=&quot;true&quot;&gt;&#10;                &lt;attribute name=&quot;modifiers&quot;&gt;{&quot;invisible&quot;: [[&quot;is_decline_stage&quot;,&quot;=&quot;, true]]}&lt;/attribute&gt;&#10;            &lt;/xpath&gt;&#10;             &lt;!-- Also target the second Lost button occurrence if present --&gt;&#10;            &lt;xpath expr=&quot;(//form/header/button[@name='%(crm.crm_lead_lost_action)d'])[2]&quot; position=&quot;attributes&quot; optional=&quot;true&quot;&gt;&#10;                &lt;attribute name=&quot;invisible&quot;&gt;is_decline_stage&lt;/attribute&gt;&#10;                &lt;attribute name=&quot;modifiers&quot;&gt;{&quot;invisible&quot;: [[&quot;is_decline_stage&quot;,&quot;=&quot;, true]]}&lt;/attribute&gt;&#10;            &lt;/xpath&gt;&#10;&#10;            &lt;!-- Existing info before the notebook --&gt;&#10;            &lt;xpath expr=&quot;//sheet/notebook&quot; position=&quot;before&quot;&gt;&#10;                &lt;group colspan=&quot;2&quot;&gt;&#10;                    &lt;group string=&quot;Contract Details&quot;&gt;&#10;                        &lt;field name=&quot;contract_type&quot; widget=&quot;radio&quot;/&gt;&#10;                        &lt;field name=&quot;contract_months&quot;/&gt;&#10;                        &lt;field name=&quot;expected_start_date&quot;/&gt;&#10;                        &lt;field name=&quot;date_go_live&quot;/&gt;&#10;                        &lt;!-- date_secured readonly unless computed boolean is_contract_stage is True --&gt;&#10;                        &lt;field name=&quot;date_secured&quot; modifiers='{&quot;readonly&quot;:[[&quot;is_contract_stage&quot;,&quot;=&quot;, false]]}'/&gt;&#10;                        &lt;!-- New: inline attachment stored on the lead; editable only in Shortlisted or Verbal stages --&gt;&#10;                        &lt;field name=&quot;attachment_file&quot; filename=&quot;attachment_filename&quot; modifiers='{&quot;readonly&quot;:[[&quot;is_contract_stage&quot;,&quot;=&quot;, false]]}'/&gt;&#10;                        &lt;field name=&quot;attachment_filename&quot; readonly=&quot;1&quot;/&gt;&#10;                        &lt;!-- computed boolean used in modifiers must be present in the view --&gt;&#10;                        &lt;field name=&quot;is_contract_stage&quot; invisible=&quot;1&quot;/&gt;&#10;                        &lt;!-- computed boolean used to hide buttons when the lead is in a Decline stage --&gt;&#10;                        &lt;field name=&quot;is_decline_stage&quot; invisible=&quot;1&quot;/&gt;&#10;                        &lt;!-- computed boolean used to make fields required/visible when in Qualify --&gt;&#10;                        &lt;field name=&quot;is_qualify_stage&quot; invisible=&quot;1&quot;/&gt;&#10;                    &lt;/group&gt;&#10;&#10;                    &lt;group string=&quot;Service Information&quot;&gt;&#10;                        &lt;field name=&quot;scope_of_service&quot;/&gt;&#10;                        &lt;field name=&quot;freight_type&quot; invisible=&quot;scope_of_service != 'freight_forwarding'&quot;/&gt;&#10;                        &lt;field name=&quot;origin_country_id&quot;/&gt;&#10;                        &lt;field name=&quot;destination_country_id&quot;/&gt;&#10;                        &lt;field name=&quot;port_of_loading_id&quot;/&gt;&#10;                        &lt;field name=&quot;port_of_destination_id&quot;/&gt;&#10;                        &lt;field name=&quot;product&quot;/&gt;&#10;                    &lt;/group&gt;&#10;                &lt;/group&gt;&#10;&#10;                &lt;group colspan=&quot;2&quot;&gt;&#10;                    &lt;group string=&quot;Additional Info&quot;&gt;&#10;                        &lt;field name=&quot;dept_region&quot;/&gt;&#10;                        &lt;field name=&quot;realized_revenue_fy2025&quot;/&gt;&#10;                        &lt;!-- moved fields: remark, operating_profit_margin, expected_revenue_annum --&gt;&#10;                        &lt;field name=&quot;remark&quot;/&gt;&#10;                        &lt;field name=&quot;operating_profit_margin&quot; widget=&quot;percent&quot; modifiers='{&quot;required&quot;:[[&quot;is_qualify_stage&quot;,&quot;=&quot;, true]]}'/&gt;&#10;                        &lt;field name=&quot;expected_revenue_annum&quot; modifiers='{&quot;required&quot;:[[&quot;is_qualify_stage&quot;,&quot;=&quot;, true]]}'/&gt;&#10;                        &lt;!-- Quotation attachment required in Qualify and editable in Qualify stage --&gt;&#10;                        &lt;field name=&quot;quotation_attachment&quot; filename=&quot;quotation_attachment_filename&quot; modifiers='{&quot;required&quot;:[[&quot;is_qualify_stage&quot;,&quot;=&quot;, true]], &quot;readonly&quot;:[[&quot;is_qualify_stage&quot;,&quot;=&quot;, false]]}'/&gt;&#10;                        &lt;field name=&quot;quotation_attachment_filename&quot; readonly=&quot;1&quot;/&gt;&#10;                        &lt;!-- Hide category_type as requested --&gt;&#10;                        &lt;field name=&quot;category_type&quot; invisible=&quot;1&quot;/&gt;&#10;                    &lt;/group&gt;&#10;                &lt;/group&gt;&#10;            &lt;/xpath&gt;&#10;&#10;            &lt;!-- ✅ Fixed &quot;Activities&quot; tab --&gt;&#10;            &lt;xpath expr=&quot;//sheet/notebook&quot; position=&quot;inside&quot;&gt;&#10;                &lt;page string=&quot;Activities&quot;&gt;&#10;                    &lt;field name=&quot;activity_ids&quot; widget=&quot;mail_activity&quot; nolabel=&quot;1&quot;/&gt;&#10;                &lt;/page&gt;&#10;            &lt;/xpath&gt;&#10;&#10;            &lt;xpath expr=&quot;//label[@for='probability']&quot; position=&quot;attributes&quot;&gt;&#10;                &lt;attribute name=&quot;invisible&quot;&gt;1&lt;/attribute&gt;&#10;            &lt;/xpath&gt;&#10;            &lt;xpath expr=&quot;//field[@name='probability']&quot; position=&quot;attributes&quot;&gt;&#10;                &lt;attribute name=&quot;invisible&quot;&gt;1&lt;/attribute&gt;&#10;            &lt;/xpath&gt;&#10;            &lt;xpath expr=&quot;//field[@name='probability']&quot; position=&quot;after&quot;&gt;&#10;                &lt;div style=&quot;display:flex; flex-direction:column;&quot; class=&quot;mb-2 ms-3&quot;&gt;&#10;                    &lt;label for=&quot;priority&quot; string=&quot;Priority&quot; style=&quot;font-weight:bold;&quot; class=&quot;mb-1 mt-2&quot;/&gt;&#10;                    &lt;field name=&quot;priority&quot; widget=&quot;priority&quot; nolabel=&quot;1&quot;/&gt;&#10;                &lt;/div&gt;&#10;            &lt;/xpath&gt;&#10;        &lt;/field&gt;&#10;    &lt;/record&gt;&#10;&#10;    &lt;!-- Custom Tree View --&gt;&#10;    &lt;record id=&quot;view_crm_lead_tree_custom&quot; model=&quot;ir.ui.view&quot;&gt;&#10;        &lt;field name=&quot;name&quot;&gt;crm.lead.tree.custom&lt;/field&gt;&#10;        &lt;field name=&quot;model&quot;&gt;crm.lead&lt;/field&gt;&#10;        &lt;field name=&quot;inherit_id&quot; ref=&quot;crm.crm_case_tree_view_oppor&quot;/&gt;&#10;        &lt;field name=&quot;arch&quot; type=&quot;xml&quot;&gt;&#10;            &lt;xpath expr=&quot;field[@name='name']&quot; position=&quot;after&quot;&gt;&#10;                &lt;field name=&quot;team_id&quot; invisible=&quot;1&quot; optional=&quot;show&quot;/&gt;&#10;&lt;!--                &lt;field name=&quot;name&quot; string=&quot;Project&quot; optional=&quot;show&quot;/&gt;--&gt;&#10;&lt;!--                &lt;field name=&quot;partner_id&quot; string=&quot;Customer&quot; optional=&quot;show&quot;/&gt;--&gt;&#10;&#10;&lt;!--                &lt;field name=&quot;user_id&quot; string=&quot;PIC&quot; optional=&quot;show&quot;/&gt;--&gt;&#10;&lt;!--                &lt;field name=&quot;create_date&quot; string=&quot;Date Funnel&quot; optional=&quot;show&quot;/&gt;--&gt;&#10;            &lt;/xpath&gt;&#10;            &lt;xpath expr=&quot;field[@name='stage_id']&quot; position=&quot;after&quot;&gt;&#10;                &lt;field name=&quot;description&quot; string=&quot;Remarks&quot; optional=&quot;show&quot;/&gt;&#10;            &lt;/xpath&gt;&#10;            &lt;xpath expr=&quot;field[@name='create_date']&quot; position=&quot;after&quot;&gt;&#10;                &lt;field name=&quot;expected_start_date&quot; string=&quot;Expected Start Date&quot; optional=&quot;show&quot;/&gt;&#10;                &lt;field name=&quot;date_secured&quot; string=&quot;Date Secured&quot; optional=&quot;show&quot;/&gt;&#10;                &lt;field name=&quot;date_go_live&quot; string=&quot;Date Go Live&quot; optional=&quot;show&quot;/&gt;&#10;                &lt;field name=&quot;scope_of_service&quot; string=&quot;Scope of service&quot; optional=&quot;show&quot;/&gt;&#10;                &lt;field name=&quot;product&quot; string=&quot;Product&quot; optional=&quot;show&quot;/&gt;&#10;                &lt;field name=&quot;dept_region&quot; string=&quot;Dept/region&quot; optional=&quot;show&quot;/&gt;&#10;                &lt;field name=&quot;realized_revenue_fy2025&quot; optional=&quot;show&quot;/&gt;&#10;            &lt;/xpath&gt;&#10;&lt;!--            &lt;xpath expr=&quot;//field[@name='create_date']&quot; position=&quot;after&quot;&gt;--&gt;&#10;&lt;!--                &lt;field name=&quot;priority&quot; widget=&quot;priority&quot;/&gt;--&gt;&#10;&lt;!--            &lt;/xpath&gt;--&gt;&#10;            &lt;xpath expr=&quot;//field[@name='probability']&quot; position=&quot;attributes&quot;&gt;&#10;                &lt;attribute name=&quot;invisible&quot;&gt;1&lt;/attribute&gt;&#10;            &lt;/xpath&gt;&#10;        &lt;/field&gt;&#10;    &lt;/record&gt;&#10;&#10;    &lt;!-- Action + Menu: open mail.activity tree under Sales --&gt;&#10;    &lt;!-- Calendar view for mail.activity (PLB) - compatible with mail.activity fields --&gt;&#10;    &lt;record id=&quot;plb_mail_activity_view_calendar&quot; model=&quot;ir.ui.view&quot;&gt;&#10;        &lt;field name=&quot;name&quot;&gt;mail.activity.calendar.plb&lt;/field&gt;&#10;        &lt;field name=&quot;model&quot;&gt;mail.activity&lt;/field&gt;&#10;        &lt;field name=&quot;arch&quot; type=&quot;xml&quot;&gt;&#10;            &lt;!-- Use date_deadline as the start (and stop) date so calendar can render activities --&gt;&#10;            &lt;calendar string=&quot;Activities (PLB)&quot; date_start=&quot;date_deadline&quot; date_stop=&quot;date_deadline&quot; color=&quot;user_id&quot;&gt;&#10;                &lt;field name=&quot;summary&quot;/&gt;&#10;                &lt;field name=&quot;date_deadline&quot;/&gt;&#10;                &lt;field name=&quot;user_id&quot;/&gt;&#10;                &lt;field name=&quot;partner_id&quot;/&gt;&#10;            &lt;/calendar&gt;&#10;        &lt;/field&gt;&#10;    &lt;/record&gt;&#10;&#10;    &lt;record id=&quot;action_mail_activity_my_plb&quot; model=&quot;ir.actions.act_window&quot;&gt;&#10;        &lt;field name=&quot;name&quot;&gt;My Activities (PLB)&lt;/field&gt;&#10;        &lt;field name=&quot;res_model&quot;&gt;mail.activity&lt;/field&gt;&#10;        &lt;!-- Expose calendar view in addition to tree and form. We provide a PLB calendar view&#10;             compatible with `mail.activity` so users can switch to Calendar without&#10;             loading the calendar.event view (which expects different fields). --&gt;&#10;        &lt;field name=&quot;view_mode&quot;&gt;tree,form,calendar&lt;/field&gt;&#10;        &lt;!-- Keep the tree view as the default view_id --&gt;&#10;        &lt;field name=&quot;view_id&quot; ref=&quot;mail.mail_activity_view_tree&quot;/&gt;&#10;        &lt;field name=&quot;search_view_id&quot; ref=&quot;mail.mail_activity_view_search&quot;/&gt;&#10;        &lt;!-- Provide explicit view entries so the calendar view appears in the view switcher.&#10;             Note: the referenced calendar view is an external ID and should exist in the&#10;             `calendar` module. We provide a PLB calendar view compatible with `mail.activity`.&#10;         --&gt;&#10;        &lt;field name=&quot;view_ids&quot; eval=&quot;[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('mail.mail_activity_view_tree')}), (0, 0, {'view_mode': 'form', 'view_id': ref('mail.mail_activity_view_form')}), (0, 0, {'view_mode': 'calendar', 'view_id': ref('PLB_input.plb_mail_activity_view_calendar')})]&quot;/&gt;&#10;        &lt;field name=&quot;domain&quot;&gt;[('res_model', '=', 'crm.lead')]&lt;/field&gt;&#10;    &lt;/record&gt;&#10;&#10;    &lt;menuitem id=&quot;menu_my_activities_plb&quot;&#10;              name=&quot;My Activities (PLB)&quot;&#10;              parent=&quot;crm.crm_menu_sales&quot;&#10;              action=&quot;PLB_input.action_mail_activity_my_plb&quot;/&gt;&#10;&#10;    &lt;!-- Inherit mail.activity tree to add partner column before res_name and user_id after date_deadline --&gt;&#10;    &lt;record id=&quot;view_mail_activity_tree_inherit_plb&quot; model=&quot;ir.ui.view&quot;&gt;&#10;        &lt;field name=&quot;name&quot;&gt;mail.activity.view.tree.plb.inherit&lt;/field&gt;&#10;        &lt;field name=&quot;model&quot;&gt;mail.activity&lt;/field&gt;&#10;        &lt;field name=&quot;inherit_id&quot; ref=&quot;mail.mail_activity_view_tree&quot;/&gt;&#10;        &lt;field name=&quot;arch&quot; type=&quot;xml&quot;&gt;&#10;            &lt;!-- Change field labels --&gt;&#10;            &lt;xpath expr=&quot;//tree/field[@name='activity_type_id']&quot; position=&quot;attributes&quot;&gt;&#10;                &lt;attribute name=&quot;string&quot;&gt;How&lt;/attribute&gt;&#10;            &lt;/xpath&gt;&#10;            &lt;xpath expr=&quot;//tree/field[@name='summary']&quot; position=&quot;attributes&quot;&gt;&#10;                &lt;attribute name=&quot;string&quot;&gt;What&lt;/attribute&gt;&#10;            &lt;/xpath&gt;&#10;            &lt;!-- date_deadline label updated to include question mark --&gt;&#10;            &lt;xpath expr=&quot;//tree/field[@name='activity_type_id']&quot; position=&quot;after&quot;&gt;&#10;                &lt;field name=&quot;date_deadline&quot; string=&quot;When&quot;/&gt;&#10;            &lt;/xpath&gt;&#10;            &lt;xpath expr=&quot;//tree/field[@name='date_deadline']&quot; position=&quot;after&quot;&gt;&#10;                &lt;field name=&quot;partner_id&quot;/&gt;&#10;                &lt;field name=&quot;user_id&quot; string=&quot;Sales&quot;/&gt;&#10;            &lt;/xpath&gt;&#10;            &lt;xpath expr=&quot;//tree/field[@name='res_name']&quot; position=&quot;replace&quot;/&gt;&#10;&#10;            &lt;xpath expr=&quot;//tree/field[@name='partner_id']&quot; position=&quot;after&quot;&gt;&#10;                &lt;field name=&quot;contact_id&quot;/&gt;&#10;            &lt;/xpath&gt;&#10;            &lt;xpath expr=&quot;//tree/field[@name='contact_id']&quot; position=&quot;after&quot;&gt;&#10;                &lt;field name=&quot;contact_position&quot;/&gt;&#10;            &lt;/xpath&gt;&#10;            &lt;xpath expr=&quot;//tree/field[@name='summary']&quot; position=&quot;after&quot;&gt;&#10;                &lt;field name=&quot;plb_why&quot;/&gt;&#10;                &lt;field name=&quot;plb_week&quot;/&gt;&#10;            &lt;/xpath&gt;&#10;        &lt;/field&gt;&#10;    &lt;/record&gt;&#10;&#10;    &lt;!-- Inherit the mail.activity form to allow assigning a Contact on the activity popup --&gt;&#10;    &lt;record id=&quot;view_mail_activity_form_inherit_plb&quot; model=&quot;ir.ui.view&quot;&gt;&#10;        &lt;field name=&quot;name&quot;&gt;mail.activity.view.form.plb.inherit&lt;/field&gt;&#10;        &lt;field name=&quot;model&quot;&gt;mail.activity&lt;/field&gt;&#10;        &lt;field name=&quot;inherit_id&quot; ref=&quot;mail.mail_activity_view_form&quot;/&gt;&#10;        &lt;field name=&quot;arch&quot; type=&quot;xml&quot;&gt;&#10;            &lt;!-- Change label for the due date field in the activity form --&gt;&#10;            &lt;xpath expr=&quot;//field[@name='date_deadline']&quot; position=&quot;attributes&quot;&gt;&#10;                &lt;attribute name=&quot;string&quot;&gt;When ?&lt;/attribute&gt;&#10;            &lt;/xpath&gt;&#10;            &lt;xpath expr=&quot;//field[@name='summary']&quot; position=&quot;after&quot;&gt;&#10;                &lt;field name=&quot;contact_id&quot;/&gt;&#10;                &lt;field name=&quot;plb_why&quot;/&gt;&#10;            &lt;/xpath&gt;&#10;        &lt;/field&gt;&#10;    &lt;/record&gt;&#10;&#10;    &lt;!-- Also add contact_id to the popup form used by the activity widget --&gt;&#10;    &lt;record id=&quot;view_mail_activity_form_popup_inherit_plb&quot; model=&quot;ir.ui.view&quot;&gt;&#10;        &lt;field name=&quot;name&quot;&gt;mail.activity.view.form.popup.plb.inherit&lt;/field&gt;&#10;        &lt;field name=&quot;model&quot;&gt;mail.activity&lt;/field&gt;&#10;        &lt;field name=&quot;inherit_id&quot; ref=&quot;mail.mail_activity_view_form_popup&quot;/&gt;&#10;        &lt;field name=&quot;arch&quot; type=&quot;xml&quot;&gt;&#10;            &lt;!-- Change label for due date in popup form --&gt;&#10;            &lt;xpath expr=&quot;//field[@name='date_deadline']&quot; position=&quot;attributes&quot;&gt;&#10;                &lt;attribute name=&quot;string&quot;&gt;When ?&lt;/attribute&gt;&#10;            &lt;/xpath&gt;&#10;            &lt;xpath expr=&quot;//field[@name='summary']&quot; position=&quot;after&quot;&gt;&#10;                &lt;field name=&quot;contact_id&quot;/&gt;&#10;                &lt;field name=&quot;plb_why&quot;/&gt;&#10;            &lt;/xpath&gt;&#10;        &lt;/field&gt;&#10;    &lt;/record&gt;&#10;&#10;    &lt;!-- Add contact_id to the &quot;without record access&quot; activity form as well --&gt;&#10;    &lt;record id=&quot;view_mail_activity_form_without_access_inherit_plb&quot; model=&quot;ir.ui.view&quot;&gt;&#10;        &lt;field name=&quot;name&quot;&gt;mail.activity.view.form.without.record.access.plb.inherit&lt;/field&gt;&#10;        &lt;field name=&quot;model&quot;&gt;mail.activity&lt;/field&gt;&#10;        &lt;field name=&quot;inherit_id&quot; ref=&quot;mail.mail_activity_view_form_without_record_access&quot;/&gt;&#10;        &lt;field name=&quot;arch&quot; type=&quot;xml&quot;&gt;&#10;            &lt;!-- Change label for due date in the no-access form --&gt;&#10;            &lt;xpath expr=&quot;//field[@name='date_deadline']&quot; position=&quot;attributes&quot;&gt;&#10;                &lt;attribute name=&quot;string&quot;&gt;When ?&lt;/attribute&gt;&#10;            &lt;/xpath&gt;&#10;            &lt;xpath expr=&quot;//group&quot; position=&quot;inside&quot;&gt;&#10;                &lt;field name=&quot;contact_id&quot;/&gt;&#10;                &lt;field name=&quot;plb_why&quot;/&gt;&#10;            &lt;/xpath&gt;&#10;        &lt;/field&gt;&#10;    &lt;/record&gt;&#10;&#10;&lt;/odoo&gt;&#10;" />
              <option name="updatedContent" value="&lt;odoo&gt;&#10;    &lt;!-- New action to open the scheduling wizard as a modal (moved early so views can reference it) --&gt;&#10;    &lt;record id=&quot;action_schedule_activity_plb&quot; model=&quot;ir.actions.act_window&quot;&gt;&#10;        &lt;field name=&quot;name&quot;&gt;Schedule Activity&lt;/field&gt;&#10;        &lt;field name=&quot;res_model&quot;&gt;mail.activity.schedule&lt;/field&gt;&#10;        &lt;field name=&quot;view_mode&quot;&gt;form&lt;/field&gt;&#10;        &lt;field name=&quot;target&quot;&gt;new&lt;/field&gt;&#10;        &lt;field name=&quot;context&quot;&gt;{'default_res_model': 'crm.lead', 'default_res_id': active_id}&lt;/field&gt;&#10;    &lt;/record&gt;&#10;&#10;    &lt;!-- Custom Form View --&gt;&#10;    &lt;record id=&quot;view_crm_lead_form_custom&quot; model=&quot;ir.ui.view&quot;&gt;&#10;        &lt;field name=&quot;name&quot;&gt;crm.lead.form.custom&lt;/field&gt;&#10;        &lt;field name=&quot;model&quot;&gt;crm.lead&lt;/field&gt;&#10;        &lt;field name=&quot;inherit_id&quot; ref=&quot;crm.crm_lead_view_form&quot;/&gt;&#10;        &lt;field name=&quot;arch&quot; type=&quot;xml&quot;&gt;&#10;&#10;            &lt;!-- Add Decline button to the form header --&gt;&#10;            &lt;xpath expr=&quot;//form/header&quot; position=&quot;inside&quot;&gt;&#10;                    &lt;!-- ensure the computed flag is available to header modifiers --&gt;&#10;                &lt;field name=&quot;is_decline_stage&quot; invisible=&quot;1&quot;/&gt;&#10;                &lt;button name=&quot;action_decline&quot; string=&quot;Decline&quot; type=&quot;object&quot; class=&quot;btn-danger&quot; groups=&quot;base.group_system&quot;/&gt;&#10;            &lt;/xpath&gt;&#10;&#10;            &lt;!-- Hide core Won button when stage is Decline --&gt;&#10;            &lt;xpath expr=&quot;//form/header/button[@name='action_set_won_rainbowman']&quot; position=&quot;replace&quot; optional=&quot;true&quot;&g