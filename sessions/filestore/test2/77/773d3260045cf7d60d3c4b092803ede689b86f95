                        }
                    },
                };
            },
        };
        serviceRegistry.add("action", mockedActionService, { force: true });

        serverData.models = {
            // we want the data to be minimal to have a minimal test
            foo: {
                fields: { int_field: { string: "int_field", type: "integer", sortable: true } },
                records: [
                    { id: 1, int_field: 1 },
                    { id: 2 },
                    { id: 3, int_field: 3 },
                    { id: 4, int_field: 2 },
                ],
            },
        };
