    return getValue(el, "filterGroup", ...args);
}

function getFilterGroupContent(el, ...args) {
    const group = getFilterGroup(el, ...args);
    return [getContent(group, "groupHeader")[0], getFiltersContent(group)];
}

function getCounters(v) {
