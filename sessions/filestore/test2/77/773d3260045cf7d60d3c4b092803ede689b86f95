                    onMounted(() => assert.step(`[${prefix}] onMounted`));
                    onPatched(() => assert.step(`[${prefix}] onPatched`));
                    onWillStart(() => assert.step(`[${prefix}] onWillStart`));
                    onWillUpdateProps(() => assert.step(`[${prefix}] onWillUpdateProps`));
                },
            });
        }
