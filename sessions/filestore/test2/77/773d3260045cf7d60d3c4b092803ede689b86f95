                            break;
                        case 3:
                            assert.deepEqual(commands, [
                                [0, commands[0][1], { display_name: "new record page 1" }],
                                [2, 11],
                                [2, 52],
                                [0, commands[3][1], { display_name: "new record page 2" }],
