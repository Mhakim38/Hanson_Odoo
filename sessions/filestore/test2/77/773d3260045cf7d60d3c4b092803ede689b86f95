                query_result['max_user_7'] = Math.max(...recordsUser7.map(r => r.planned_revenue));

                if (query_result.total_won === 1) {
                    message = "Go, go, go! Congrats for your first deal.";
                } else if (query_result.max_team_30 === record.planned_revenue) {
