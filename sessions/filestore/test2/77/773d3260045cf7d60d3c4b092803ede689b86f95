            const rec = serverData.models.partner.records.find((rec) => rec.id === 1);
            rec.document = "3 kb";
            rec.write_date = "2022-08-05 08:37:00"; // 1659688620000

            // 1659692220000, 1659695820000
            const lastUpdates = ["2022-08-05 09:37:00", "2022-08-05 10:37:00"];
            let index = 0;

            await makeView({
                type: "form",
                resModel: "partner",
